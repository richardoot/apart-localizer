# Variables lues par la CLI Supabase (`supabase start`) pour supabase/config.toml.
# Copie locale : supabase/.env, ignoré par git, écrit par `pnpm stack:up`.

# Connexion Google en local (facultative) : identifiant OAuth « application web »
# de Google Cloud, URI de redirection http://127.0.0.1:54321/auth/v1/callback.
# Laissés vides, Google est désactivé et la connexion par e-mail suffit.
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=

# Écrit par `pnpm stack:up` : true seulement si les deux valeurs ci-dessus sont
# renseignées (sans lui, `supabase start` seul lit « env(...) » non défini).
SUPABASE_AUTH_GOOGLE_ENABLED=false
