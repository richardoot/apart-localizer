# Variables du web. En local, `pnpm stack:up` crée apps/web/.env depuis ce
# modèle et y écrit l'URL et la clé anon de Supabase local, plus la connexion
# par e-mail et mot de passe réservée au développement (docs/developpement-local.md,
# ADR 0016) ; celle-ci n'a pas sa place ici et ne se pose jamais en production,
# où Google reste le seul moyen de se connecter.

# Supabase (projet local : `pnpm stack:up` les écrit d'après `supabase status`).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# API NestJS.
VITE_API_URL=http://localhost:3000

# Fond de carte MapLibre : une URL de style sans clé. Par défaut le style
# « Liberty » d'OpenFreeMap (tuiles OpenStreetMap, libre, sans inscription) :
# https://tiles.openfreemap.org/styles/liberty. Une autre URL de style
# (IGN Géoplateforme, style maison) la remplace. Les tests n'en chargent jamais.
VITE_MAP_STYLE_URL=

# Sentry côté navigateur, activé seulement si le DSN est renseigné.
# VITE_SENTRY_TRACES_SAMPLE_RATE : fraction des navigations tracées (défaut 1).
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=
