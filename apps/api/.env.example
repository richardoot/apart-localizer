# Variables de l'API. En local, `pnpm stack:up` crée apps/api/.env depuis ce
# modèle puis le complète par fusion (docs/developpement-local.md) : il réécrit
# DATABASE_URL, DIRECT_URL (vide), TEST_DATABASE_URL, SUPABASE_URL et
# SUPABASE_SERVICE_ROLE_KEY d'après `supabase status`, génère une paire VAPID
# locale si elle manque, et ne touche à rien d'autre (vos clés restent ; un
# fichier existant est d'abord copié en .env.backup). En production, chaque
# valeur se pose dans le projet Vercel (docs/deploiement.md).

# Base de données Postgres (+ PostGIS).
# DATABASE_URL = connexion du serveur (pooler Supabase en production).
# DIRECT_URL   = connexion directe pour les migrations (facultatif en local).
# Supabase CLI en local : postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Repli docker/test-db.yml : postgresql://postgres:postgres@127.0.0.1:54329/apart
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DIRECT_URL=

# Base des tests e2e : un serveur Postgres avec PostGIS où le harnais crée une
# base par fichier de test. Jamais la base de développement.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/postgres

# Supabase Auth. En local, `pnpm stack:up` les écrit (`supabase status -o env`).
# SUPABASE_URL = URL du projet (API). SUPABASE_SERVICE_ROLE_KEY = clé service_role.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# MCP : découverte OAuth (RFC 9728 / RFC 8414).
# SUPABASE_EXTERNAL_URL = URL du projet Supabase telle qu'un client MCP
#   (claude.ai) l'atteint ; défaut : SUPABASE_URL (identique en cloud).
# MCP_PUBLIC_URL = URL publique de l'endpoint MCP annoncée comme ressource
#   protégée (https://<api>.vercel.app/mcp) ; défaut : déduite de la requête.
SUPABASE_EXTERNAL_URL=
MCP_PUBLIC_URL=

# Origines autorisées (CORS), séparées par des virgules.
FRONTEND_URL=http://localhost:5173

# Port d'écoute de l'API.
PORT=3000

# Journalisation. LOG_FORMAT = json | pretty (défaut : json en production,
# pretty ailleurs). LOG_LEVEL = verbose | debug | log | warn | error | fatal.
LOG_FORMAT=
LOG_LEVEL=

# API_DOCS=1 sert /api/docs même en production (jamais par défaut).
API_DOCS=

# Sentry, activé seulement si le DSN est renseigné. SENTRY_TRACES_SAMPLE_RATE :
# fraction des requêtes tracées, de 0 à 1 (défaut 1).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=

# Garde-fou de débit par adresse IP, toutes routes (santé, découverte, MCP,
# REST) : THROTTLE_LIMIT requêtes par fenêtre de THROTTLE_TTL_MS millisecondes.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=300

# IA (lot 2) : extraction d'une annonce depuis un texte collé ou des captures.
# ANTHROPIC_API_KEY ne vit qu'ici, côté serveur ; vide = IA désactivée :
# POST /listings/extract répond 503, tout le reste fonctionne.
# AI_MODEL = modèle par défaut (claude-opus-5-5), AI_MODEL_BULK = relecture
# rapide et repli (claude-haiku-5-5), AI_EFFORT = low | medium | high,
# AI_MAX_TOKENS = plafond de sortie, AI_MAX_IMAGES (défaut 4, 8 au plus),
# AI_MAX_IMAGE_MB (défaut 5). Voir docs/ia.md.
ANTHROPIC_API_KEY=
AI_MODEL=
AI_MODEL_BULK=
AI_EFFORT=
AI_MAX_TOKENS=
AI_MAX_IMAGES=
AI_MAX_IMAGE_MB=

# Géocodeur IGN Géoplateforme (défaut https://data.geopf.fr/geocodage/search/),
# cache en base dans reference_data.
GEOCODING_URL=
# Données ouvertes (lot 4) : services appelés à la volée, avec cache en base.
# Vides = adresses par défaut (Géoplateforme IGN, observatoire DPE de l'ADEME).
ISOCHRONE_URL=
ADEME_DPE_URL=
# Lot 5 : rapport de risques Géorisques (API v1, sans jeton), cache trente jours.
# Vide = https://www.georisques.gouv.fr/api/v1/resultats_rapport_risque
GEORISQUES_URL=

# Lot 6 : photos de visite dans Supabase Storage (bucket privé, voir
# docs/deploiement.md). Vides = bucket « visit-photos », URL de lecture
# signées valables 600 s (30 à 3 600).
STORAGE_BUCKET_VISIT_PHOTOS=
STORAGE_SIGNED_URL_TTL_SECONDS=

# Web push (notifications de la PWA) : clés VAPID générées une fois avec
# `npx web-push generate-vapid-keys`, jamais commitées. VAPID_SUBJECT =
# mailto:adresse ou https://site. Vides = push désactivé, la cloche reste.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# E-mail de notification (facultatif) : un point d'envoi HTTP qui accepte
# POST { from, to, subject, text, html } (jeton en Bearer). Vides = inerte.
EMAIL_HTTP_URL=
EMAIL_HTTP_TOKEN=
EMAIL_FROM=

# Alertes e-mail transférées : secret HMAC du webhook POST /inbound/email/<espace>
# (32 caractères au moins, `openssl rand -hex 32`). Vide = webhook désactivé (503).
INBOUND_EMAIL_SECRET=
