# Base de données Postgres (+ PostGIS).
# DATABASE_URL = connexion du serveur (pooler Supabase en production).
# DIRECT_URL   = connexion directe pour les migrations (facultatif en local).
# Supabase CLI en local : postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Repli docker/test-db.yml : postgresql://postgres:postgres@127.0.0.1:54329/apart
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DIRECT_URL=

# Base des tests e2e : un serveur Postgres avec PostGIS où le harnais crée une
# base par fichier de test. Jamais la base de développement.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/postgres

# Supabase Auth. En local, `supabase start` affiche l'URL et les clés.
# SUPABASE_URL = URL du projet (API). SUPABASE_SERVICE_ROLE_KEY = clé service_role.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# MCP : découverte OAuth (RFC 9728 / RFC 8414).
# SUPABASE_EXTERNAL_URL = URL du projet Supabase telle qu'un client MCP
#   (claude.ai) l'atteint ; défaut : SUPABASE_URL (identique en cloud).
# MCP_PUBLIC_URL = URL publique de l'endpoint MCP annoncée comme ressource
#   protégée (https://<api>.vercel.app/mcp) ; défaut : déduite de la requête.
SUPABASE_EXTERNAL_URL=
MCP_PUBLIC_URL=

# Origines autorisées (CORS), séparées par des virgules.
FRONTEND_URL=http://localhost:5173

# Port d'écoute de l'API.
PORT=3000

# Journalisation. LOG_FORMAT = json | pretty (défaut : json en production,
# pretty ailleurs). LOG_LEVEL = verbose | debug | log | warn | error | fatal.
LOG_FORMAT=
LOG_LEVEL=

# API_DOCS=1 sert /api/docs même en production (jamais par défaut).
API_DOCS=

# Sentry, activé seulement si le DSN est renseigné. SENTRY_TRACES_SAMPLE_RATE :
# fraction des requêtes tracées, de 0 à 1 (défaut 1).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=

# Garde-fou de débit par adresse IP, toutes routes (santé, découverte, MCP,
# REST) : THROTTLE_LIMIT requêtes par fenêtre de THROTTLE_TTL_MS millisecondes.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=300
