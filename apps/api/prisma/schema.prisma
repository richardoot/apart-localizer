// Modèle de données d'apart-localizer (étude du besoin § 4).
//
// Tout vit dans le schéma Postgres `app`, à l'écart des schémas de Supabase
// (`auth`, `storage`) et hors de l'exposition PostgREST (`public`). Les
// colonnes géographiques sont des `geography` PostGIS déclarées Unsupported,
// doublées de latitude et longitude classiques pour les lectures ordinaires ;
// le SQL qui les manipule vit dans le module `geo` et nulle part ailleurs.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["app"]
}

// ---------------------------------------------------------------------------
// Énumérations (identifiants alignés sur packages/contracts)
// ---------------------------------------------------------------------------

enum MemberRole {
  owner
  member

  @@schema("app")
}

/// Cycle de vie d'une ligne de membre (lot 8, ADR 0018).
enum MemberStatus {
  active
  invited
  canceled
  declined
  removed

  @@schema("app")
}

enum ListingSource {
  seloger
  leboncoin
  pap
  bienici
  agence
  autre

  @@schema("app")
}

enum ListingStatus {
  to_study
  to_visit
  visited
  offer_made
  offer_accepted
  offer_refused
  discarded
  sold_or_withdrawn

  @@schema("app")
}

enum DpeClass {
  A
  B
  C
  D
  E
  F
  G

  @@schema("app")
}

enum FieldSource {
  listing
  user
  ai
  open_data
  estimated
  agency

  @@schema("app")
}

enum LocationPrecision {
  exact
  street
  district
  commune

  @@schema("app")
}

enum FeesPayer {
  buyer
  seller

  @@schema("app")
}

enum LeaseType {
  unfurnished
  furnished
  shared

  @@schema("app")
}

enum RentControl {
  auto
  yes
  no

  @@schema("app")
}

enum RenovationLevel {
  refresh
  renovation
  heavy
  energy

  @@schema("app")
}

enum RentalDemand {
  strong
  medium
  weak

  @@schema("app")
}

enum TriState {
  yes
  no
  unknown

  @@schema("app")
}

enum TaskOrigin {
  default
  manual
  missing_field
  visit
  /// Lot 20 : « À revoir à la contre-visite », proposée depuis « Nos avis ».
  opinion

  @@schema("app")
}

enum OfferResponse {
  pending
  accepted
  refused
  counter_offer

  @@schema("app")
}

enum OfferChannel {
  email
  phone
  agency
  in_person
  letter
  other

  @@schema("app")
}

enum ActivityChannel {
  web
  mcp
  import
  system

  @@schema("app")
}

enum VisitStatus {
  planned
  done

  @@schema("app")
}

enum VisitPhotoStatus {
  pending
  ready

  @@schema("app")
}

enum NotificationType {
  listing_created
  status_changed
  task_assigned
  criteria_matched
  offer_response
  drafts_received
  member_joined
  listing_checked
  agency_answer
  /// Lot 20 : avis donné ou mis à jour par un autre membre.
  opinion_added
  /// Lot 21 : proposition d'un autre membre à confirmer (une par session de tri).
  decision_proposed
  /// Lot 21 : réponse ou décision sur une proposition (une par session de tri).
  decision_resolved

  @@schema("app")
}

/// Lot 21 : l'état d'une proposition (ADR 0031).
enum DecisionState {
  open
  to_settle
  applied
  withdrawn
  stale

  @@schema("app")
}

/// Lot 21 : le choix d'une proposition ou d'une réponse.
enum DecisionChoice {
  keep
  to_visit
  discard

  @@schema("app")
}

/// Lot 21 : comment une proposition s'est appliquée.
enum DecisionResolution {
  agreed
  settled
  without_waiting

  @@schema("app")
}

/// Lot 20 : critère par défaut (clé stable) ou ajouté par l'espace.
enum OpinionCriterionOrigin {
  default
  custom

  @@schema("app")
}

/// Résultat d'une vérification d'annonce sur le portail (lot 15, ADR 0025).
enum ListingCheckOutcome {
  unchanged
  changed
  offline
  republished
  inaccessible
  /// Lot 18 : la même annonce sur un autre portail, rattachée à la fiche.
  link_added

  @@schema("app")
}

/// État d'envoi d'une notification sur un canal (push, e-mail).
enum DeliveryStatus {
  pending
  sent
  failed
  skipped

  @@schema("app")
}

enum DraftStatus {
  pending
  accepted
  dismissed
  /// Reconnu comme une annonce déjà suivie (lot 16) : sa fiche a été mise à jour.
  merged

  @@schema("app")
}

enum DraftOrigin {
  email
  /// Exploration des portails par Claude (lot 16).
  exploration

  @@schema("app")
}

enum DraftExtractor {
  ai
  parser
  /// Claude, sur la page du portail (lot 16).
  claude

  @@schema("app")
}

enum PerimeterType {
  point_radius
  polygon
  isochrone

  @@schema("app")
}

/// Adéquation d'une annonce à un critère (lot 14, ADR 0024) : dans les
/// critères, à confirmer, à la marge, hors critères.
enum CriteriaFitLevel {
  in
  to_confirm
  margin
  out

  @@schema("app")
}

enum TransitMode {
  tram
  bus
  boat

  @@schema("app")
}

/// Portail d'un lien d'annonce (lot 18, ADR 0028) : plus riche que
/// `ListingSource` (lien principal, export de version 1), Logic-Immo compris.
enum ListingPortal {
  leboncoin
  seloger
  bienici
  pap
  logicimmo
  agence
  autre

  @@schema("app")
}

/// D'où vient un lien (lot 18) : lien d'origine de l'annonce (ou repris par
/// la migration), ajouté à la main, par Claude, trouvé par une exploration,
/// partagé depuis le téléphone, reçu dans une alerte e-mail.
enum ListingLinkOrigin {
  original
  manual
  claude
  exploration
  share
  email

  @@schema("app")
}

/// Qui vend (lot 18) : agence, mandataire, particulier, inconnu (par défaut,
/// jamais deviné).
/// Lot 27 : d'où vient une autre agence d'une annonce.
enum ListingSellerOrigin {
  manual
  claude
  link
  merge

  @@schema("app")
}

enum SellerType {
  agency
  mandatary
  private
  unknown

  @@schema("app")
}

/// Genre d'un équipement de proximité importé (lot 11).
enum AmenityKind {
  athletics_track
  supermarket_drive
  fitness_park

  @@schema("app")
}

/// Drive d'un supermarché : signalé explicitement par la source, ou donnée
/// ambiguë à vérifier. Un magasin sans aucun signal n'est pas importé.
enum DriveStatus {
  yes
  to_verify

  @@schema("app")
}

/// Nature d'un contour de quartier (lot 11) : quartier officiel d'une
/// commune, IRIS de l'INSEE à défaut, ou commune entière.
enum NeighbourhoodKind {
  quartier
  iris
  commune

  @@schema("app")
}

// ---------------------------------------------------------------------------
// Espace de travail et membres
// ---------------------------------------------------------------------------

model Workspace {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  members        Member[]
  listings       Listing[]
  assumptions    AssumptionsVersion[]
  searchCriteria SearchCriteria[]
  activityLogs   ActivityLog[]
  scenarios      Scenario[]
  notifications  Notification[]
  listingDrafts  ListingDraft[]
  visitPhotos    VisitPhoto[]
  listingChecks  ListingCheck[]
  explorations   Exploration[]

  /// Lot 17 : signature des messages aux annonceurs ; null = les prénoms des membres.
  agencySignature String?          @map("agency_signature")
  agencyRequests  AgencyRequest[]
  listingContacts ListingContact[]
  /// Lot 18 : les liens des annonces sur les portails.
  listingLinks    ListingLink[]
  // Lot 27 : autres agences d'une annonce, fusions de fiches.
  listingSellers  ListingSeller[]
  listingMerges   ListingMerge[]
  duplicatePairs  DuplicatePair[]

  /// Lot 20 : avis à l'aveugle (l'avis des autres masqué tant qu'on n'a pas
  /// noté) ; vrai par défaut.
  opinionsBlind   Boolean            @default(true) @map("opinions_blind")
  /// Lot 20 : les critères des avis ; aucune ligne = les huit par défaut.
  opinionCriteria OpinionCriterion[]

  /// Lot 21 : « Décider à plusieurs » : un changement d'étape attend l'accord
  /// de tous les membres actifs ; vrai par défaut, réglé par les propriétaires.
  decideTogether    Boolean            @default(true) @map("decide_together")
  decisionProposals DecisionProposal[]

  @@map("workspaces")
  @@schema("app")
}

/// Un membre peut être créé avant sa première connexion (import des avis de
/// Richard et Chloé) : `authUserId` est alors null et le rattachement se fait
/// par e-mail à la première connexion. Lot 8 : une invitation est une ligne
/// `invited` (sans compte, `invitedAt` renseigné) ; un membre retiré garde sa
/// ligne (`removed`, identité détachée) pour que son historique reste à son
/// nom. Invariant : `authUserId` renseigné ⇒ `status = active`.
model Member {
  id          String       @id @default(uuid())
  workspaceId String       @map("workspace_id")
  handle      String
  displayName String       @map("display_name")
  email       String?
  authUserId  String?      @unique @map("auth_user_id")
  role        MemberRole   @default(member)
  status      MemberStatus @default(active)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Invitation : envoi, auteur, échéance. Null pour un membre pré-créé
  /// (import) ou créé à sa première connexion.
  invitedAt           DateTime? @map("invited_at") @db.Timestamptz(6)
  invitedById         String?   @map("invited_by_id")
  invitationExpiresAt DateTime? @map("invitation_expires_at") @db.Timestamptz(6)
  /// Annulation (par un propriétaire) ou refus (par la personne).
  invitationClosedAt  DateTime? @map("invitation_closed_at") @db.Timestamptz(6)
  /// Première connexion dans l'espace (invitation acceptée, membre pré-créé rattaché).
  joinedAt            DateTime? @map("joined_at") @db.Timestamptz(6)
  /// Retrait par un propriétaire, ou départ (auteur = le membre lui-même).
  removedAt           DateTime? @map("removed_at") @db.Timestamptz(6)
  removedById         String?   @map("removed_by_id")

  /// Dernière activité dans l'application (visite en cours ou passée).
  lastVisitAt             DateTime? @map("last_visit_at") @db.Timestamptz(6)
  /// Point de départ de « ce qui a changé » : fin de la visite précédente
  /// ou « tout marquer comme vu ».
  whatsNewSince           DateTime? @map("whats_new_since") @db.Timestamptz(6)
  /// Origine de ce point de départ (`previous_visit`, `marked_seen`).
  whatsNewSource          String?   @map("whats_new_source")
  /// Préférences de notification par type et par canal (JSON validé par
  /// NotificationPreferencesSchema ; vide = défauts).
  notificationPreferences Json      @default("{}") @map("notification_preferences")

  workspace              Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  opinions               Opinion[]
  /// Lot 20 : les « Voir quand même » du membre.
  opinionReveals         OpinionReveal[]
  assignedTasks          Task[]             @relation("TaskAssignee")
  listingViews           ListingView[]
  createdListings        Listing[]          @relation("ListingCreator")
  offers                 Offer[]            @relation("OfferAuthor")
  searchCriteria         SearchCriteria[]
  activityLogs           ActivityLog[]
  scenarios              Scenario[]         @relation("ScenarioAuthor")
  rentComparables        RentComparable[]   @relation("RentComparableAuthor")
  visits                 Visit[]            @relation("VisitAuthor")
  visitPhotos            VisitPhoto[]       @relation("VisitPhotoAuthor")
  notifications          Notification[]
  pushSubscriptions      PushSubscription[]
  decidedDrafts          ListingDraft[]     @relation("DraftDecider")
  listingChecks          ListingCheck[]     @relation("ListingCheckAuthor")
  explorations           Exploration[]      @relation("ExplorationAuthor")
  invitedBy              Member?            @relation("MemberInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  invitees               Member[]           @relation("MemberInviter")
  removedBy              Member?            @relation("MemberRemover", fields: [removedById], references: [id], onDelete: SetNull)
  removals               Member[]           @relation("MemberRemover")
  // Lot 17 : questions aux agences.
  createdAgencyRequests  AgencyRequest[]    @relation("AgencyRequestAuthor")
  approvedAgencyRequests AgencyRequest[]    @relation("AgencyRequestApprover")
  sentAgencyRequests     AgencyRequest[]    @relation("AgencyRequestSender")
  updatedContacts        ListingContact[]   @relation("ListingContactEditor")
  // Lot 18 : les liens ajoutés.
  addedLinks             ListingLink[]      @relation("ListingLinkAuthor")
  // Lot 27 : agences ajoutées, fusions faites ou annulées.
  addedSellers           ListingSeller[]    @relation("ListingSellerAuthor")
  listingMerges          ListingMerge[]     @relation("ListingMergeAuthor")
  undoneListingMerges    ListingMerge[]     @relation("ListingMergeUndoer")
  askedDuplicatePairs    DuplicatePair[]    @relation("DuplicatePairAsker")
  decidedDuplicatePairs  DuplicatePair[]    @relation("DuplicatePairDecider")
  // Lot 21 : les décisions à plusieurs.
  authoredDecisions      DecisionProposal[] @relation("DecisionAuthor")
  closedDecisions        DecisionProposal[] @relation("DecisionCloser")
  decisionResponses      DecisionResponse[]

  @@unique([workspaceId, handle])
  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([email])
  @@map("members")
  @@schema("app")
}

// ---------------------------------------------------------------------------
// Hypothèses versionnées
// ---------------------------------------------------------------------------

/// Une ligne par version ; la plus récente par `effectiveFrom` est en vigueur.
/// `values` est le JSON validé par `AssumptionsSchema` (taux en fractions).
model AssumptionsVersion {
  id            String   @id @default(uuid())
  workspaceId   String   @map("workspace_id")
  label         String?
  effectiveFrom DateTime @default(now()) @map("effective_from") @db.Timestamptz(6)
  values        Json
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, effectiveFrom(sort: Desc)])
  @@map("assumptions_versions")
  @@schema("app")
}

// ---------------------------------------------------------------------------
// Annonces
// ---------------------------------------------------------------------------

model Listing {
  id          String @id @default(uuid())
  workspaceId String @map("workspace_id")

  // Identité
  source          ListingSource @default(autre)
  sourceLabel     String?       @map("source_label")
  url             String?
  externalId      String?       @map("external_id")
  title           String
  publishedAt     DateTime?     @map("published_at") @db.Timestamptz(6)
  sourceUpdatedAt DateTime?     @map("source_updated_at") @db.Timestamptz(6)
  description     String?
  notes           String?
  sourceText      String?       @map("source_text")

  // Localisation
  addressRaw        String?                                       @map("address_raw")
  addressNormalized String?                                       @map("address_normalized")
  banId             String?                                       @map("ban_id")
  commune           String?
  inseeCode         String?                                       @map("insee_code")
  district          String?
  latitude          Float?
  longitude         Float?
  /// Point WGS 84 ; écrit et lu uniquement par le module geo.
  geom              Unsupported("geography(Point, 4326)")?
  locationPrecision LocationPrecision?                            @map("location_precision")
  locationGeoJson   Json?                                         @map("location_geojson")
  /// Comment le repère a été placé (lot 12) : méthode, quartier retenu,
  /// texte reconnu, réserves (JSON validé par ListingPlacementSchema).
  locationPlacement Json?                                         @map("location_placement")
  /// La zone où le bien se trouve d'après l'annonce (contour du quartier
  /// retenu, ou de la commune) quand le repère est approché ; écrite et lue
  /// uniquement par le module geo.
  locationArea      Unsupported("geography(MultiPolygon, 4326)")? @map("location_area")

  // Bien
  price              Decimal    @db.Decimal(12, 2)
  feesAmount         Decimal?   @map("fees_amount") @db.Decimal(12, 2)
  feesPercent        Float?     @map("fees_percent")
  feesPayer          FeesPayer? @map("fees_payer")
  surface            Decimal?   @db.Decimal(8, 2)
  surfaceTotal       Decimal?   @map("surface_total") @db.Decimal(8, 2)
  rooms              Int?
  bedrooms           Int?
  floor              Int?
  floorsTotal        Int?       @map("floors_total")
  floorLabel         String?    @map("floor_label")
  elevator           Boolean?
  constructionYear   Int?       @map("construction_year")
  constructionPeriod String?    @map("construction_period")
  dpeClass           DpeClass?  @map("dpe_class")
  dpeConsumption     Float?     @map("dpe_consumption")
  gesClass           DpeClass?  @map("ges_class")
  dpeDate            DateTime?  @map("dpe_date") @db.Date
  dpeNumber          String?    @map("dpe_number")
  heatingType        String?    @map("heating_type")
  heatingCollective  Boolean?   @map("heating_collective")
  outdoor            String?
  parking            String?
  cellar             Boolean?
  orientation        String?
  condition          String?

  // Copropriété et fiscalité locale
  annualCharges                Decimal? @map("annual_charges") @db.Decimal(12, 2)
  nonRecoverableChargesMonthly Decimal? @map("non_recoverable_charges_monthly") @db.Decimal(10, 2)
  lotsCount                    Int?     @map("lots_count")
  proceedings                  String?
  votedWorks                   String?  @map("voted_works")
  syndic                       String?
  propertyTax                  Decimal? @map("property_tax") @db.Decimal(12, 2)
  furnitureValue               Decimal? @map("furniture_value") @db.Decimal(12, 2)

  // Provenance par champ : { champ: { source, confidence, evidence } }
  fieldSources Json @default("{}") @map("field_sources")

  // Suivi
  status        ListingStatus @default(to_study)
  discardReason String?       @map("discard_reason")
  discardedAt   DateTime?     @map("discarded_at") @db.Timestamptz(6)

  // Surcharge partielle des hypothèses par annonce : n'est plus lue ni écrite
  // depuis le lot 19 (ADR 0029, toutes les annonces se calculent avec les
  // hypothèses de l'espace) ; colonne gardée pour ne rien perdre, à supprimer
  // plus tard.
  assumptionsOverride Json? @map("assumptions_override")

  // Dernier enrichissement open data (JSON validé par ListingOpenDataContextSchema)
  openDataContext Json? @map("open_data_context")

  // Suivi des mises à jour sur le portail (lot 15, ADR 0025)
  /// Dernière vérification, quel qu'en soit le résultat.
  lastCheckedAt     DateTime? @map("last_checked_at") @db.Timestamptz(6)
  /// Dernière fois que l'annonce a été vue en ligne.
  lastSeenOnlineAt  DateTime? @map("last_seen_online_at") @db.Timestamptz(6)
  /// Annonce plus ancienne dont celle-ci est la republication (même bien) :
  /// une annonce reprend au plus une annonce et n'est reprise que par une.
  republishedFromId String?   @unique @map("republished_from_id")

  // Vendeur (lot 18, ADR 0028) : agence, mandataire, particulier ou inconnu
  // (jamais deviné), nom de l'agence ou du réseau (jamais celui d'une
  // personne : contact du lot 17), référence de l'annonce et sa clé de
  // comparaison (majuscules, sans espaces, tirets ni points).
  sellerType         SellerType @default(unknown) @map("seller_type")
  sellerName         String?    @map("seller_name")
  sellerReference    String?    @map("seller_reference")
  sellerReferenceKey String?    @map("seller_reference_key")

  // Adéquation aux critères actifs (lot 14) : le meilleur niveau parmi les
  // critères actifs (null = jamais comparée), la date de son dernier
  // changement et ce qui l'a fait changer ({ cause, trigger, criteriaName }).
  // Le détail par critère est dans criteria_matches.
  criteriaFitLevel     CriteriaFitLevel? @map("criteria_fit_level")
  criteriaFitChangedAt DateTime?         @map("criteria_fit_changed_at") @db.Timestamptz(6)
  criteriaFitOrigin    Json?             @map("criteria_fit_origin")

  // Lot 25 (ADR 0035) : la photo de couverture choisie par un membre, une
  // photo de visite de l'annonce (null : la première photo de la première
  // visite). Jamais une image de portail ; lue par URL signée à durée courte.
  coverPhotoId String? @map("cover_photo_id")

  // Lot 27 (ADR 0037) : la fiche qui a absorbé celle-ci (doublon fusionné).
  // Une fiche fusionnée est écartée, cachée des listes, jamais supprimée ;
  // la fusion s'annule (listing_merges). Null = fiche ordinaire.
  mergedIntoId String?   @map("merged_into_id")
  mergedAt     DateTime? @map("merged_at") @db.Timestamptz(6)

  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace         Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy         Member?                @relation("ListingCreator", fields: [createdById], references: [id], onDelete: SetNull)
  renovation        Renovation?
  rentalPlan        RentalPlan?
  opinions          Opinion[]
  /// Lot 20 : les « Voir quand même » des membres sur l'annonce.
  opinionReveals    OpinionReveal[]
  tasks             Task[]
  priceEvents       PriceEvent[]
  offers            Offer[]
  visits            Visit[]
  activityLogs      ActivityLog[]
  views             ListingView[]
  criteriaMatches   CriteriaMatch[]
  scenarios         Scenario[]
  rentComparables   RentComparable[]
  notifications     Notification[]
  drafts            ListingDraft[]
  checks            ListingCheck[]         @relation("ListingChecks")
  linkedChecks      ListingCheck[]         @relation("ListingCheckLinked")
  republishedFrom   Listing?               @relation("ListingRepublication", fields: [republishedFromId], references: [id], onDelete: SetNull)
  republishedAs     Listing?               @relation("ListingRepublication")
  explorationLines  ExplorationCandidate[]
  // Lot 17 : contact de l'annonceur et demandes.
  contact           ListingContact?
  agencyRequests    AgencyRequest[]
  // Lot 18 : les liens de l'annonce sur les portails.
  links             ListingLink[]
  // Lot 21 : les décisions à plusieurs sur cette annonce.
  decisionProposals DecisionProposal[]
  // Lot 25 : la photo de couverture choisie (photo supprimée : retour à la première).
  coverPhoto        VisitPhoto?            @relation("ListingCover", fields: [coverPhotoId], references: [id], onDelete: SetNull)
  // Lot 27 : les autres agences qui vendent le même bien, et les fusions.
  sellers           ListingSeller[]
  mergedInto        Listing?               @relation("ListingMerged", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedListings    Listing[]              @relation("ListingMerged")
  mergesAsKept      ListingMerge[]         @relation("ListingMergeKept")
  mergesAsAbsorbed  ListingMerge[]         @relation("ListingMergeAbsorbed")
  duplicatePairsA   DuplicatePair[]        @relation("DuplicatePairA")
  duplicatePairsB   DuplicatePair[]        @relation("DuplicatePairB")

  @@index([workspaceId, status])
  @@index([workspaceId, commune])
  @@index([workspaceId, url])
  @@index([workspaceId, criteriaFitLevel])
  @@index([workspaceId, sellerReferenceKey])
  @@index([mergedIntoId])
  @@map("listings")
  @@schema("app")
}

/// « Vu par » : un membre a ouvert l'annonce.
model ListingView {
  listingId String   @map("listing_id")
  memberId  String   @map("member_id")
  seenAt    DateTime @default(now()) @map("seen_at") @db.Timestamptz(6)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  member  Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([listingId, memberId])
  @@index([memberId])
  @@map("listing_views")
  @@schema("app")
}

/// Travaux avant emménagement.
model Renovation {
  id             String           @id @default(uuid())
  listingId      String           @unique @map("listing_id")
  active         Boolean          @default(false)
  level          RenovationLevel?
  durationMonths Int?             @map("duration_months")
  notes          String?

  listing Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  items   RenovationItem[]

  @@map("renovations")
  @@schema("app")
}

model RenovationItem {
  id           String   @id @default(uuid())
  renovationId String   @map("renovation_id")
  label        String
  amount       Decimal? @db.Decimal(12, 2)
  position     Int      @default(0)

  renovation Renovation @relation(fields: [renovationId], references: [id], onDelete: Cascade)

  @@index([renovationId])
  @@map("renovation_items")
  @@schema("app")
}

/// Phase 2 : mise en location. `comparables` (JSON) n'est plus lu depuis le
/// lot 5 : les comparables de loyer sont dans `rent_comparables` (la
/// migration du lot 5 y a recopié les éventuelles lignes) ; colonne gardée
/// pour ne rien perdre, à supprimer plus tard. `year` et `lease_type` ne
/// sont plus lus ni écrits depuis le lot 19 (ADR 0029) : l'année et le type
/// de location se règlent pour tout l'espace (`rentalYear` et `leaseType`
/// des hypothèses) ; colonnes gardées, à supprimer plus tard.
model RentalPlan {
  id                      String        @id @default(uuid())
  listingId               String        @unique @map("listing_id")
  /// N'est plus lue depuis le lot 19 (année de l'espace).
  year                    Int?
  /// N'est plus lue depuis le lot 19 (type de location de l'espace).
  leaseType               LeaseType     @default(unfurnished) @map("lease_type")
  rentControl             RentControl   @default(auto) @map("rent_control")
  referenceRentPerM2      Decimal?      @map("reference_rent_per_m2") @db.Decimal(8, 2)
  targetRent              Decimal?      @map("target_rent") @db.Decimal(10, 2)
  marketRent              Decimal?      @map("market_rent") @db.Decimal(10, 2)
  comparables             Json          @default("[]")
  demand                  RentalDemand?
  coOwnershipAllowsRental TriState      @default(unknown) @map("co_ownership_allows_rental")
  decencyCompliant        TriState      @default(unknown) @map("decency_compliant")
  rentalPermitRequired    TriState      @default(unknown) @map("rental_permit_required")
  notes                   String?

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@map("rental_plans")
  @@schema("app")
}

/// Scénario « et si » enregistré (besoin E4) : des surcharges de l'annonce et
/// des hypothèses (JSON validé par `ScenarioOverridesSchema`), pour une
/// annonce ou pour tout l'espace (`listingId` null).
model Scenario {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  listingId   String?  @map("listing_id")
  name        String
  overrides   Json     @default("{}")
  notes       String?
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  listing   Listing?  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdBy Member?   @relation("ScenarioAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([listingId])
  @@map("scenarios")
  @@schema("app")
}

/// Annonce de location comparable saisie à la main (besoin L4) : la matière
/// du loyer de marché d'une annonce.
model RentComparable {
  id          String        @id @default(uuid())
  listingId   String        @map("listing_id")
  rent        Decimal       @db.Decimal(10, 2)
  surface     Decimal       @db.Decimal(8, 2)
  furnished   Boolean       @default(false)
  rooms       Int?
  observedAt  DateTime?     @map("observed_at") @db.Date
  source      ListingSource @default(autre)
  sourceLabel String?       @map("source_label")
  url         String?
  address     String?
  note        String?
  createdById String?       @map("created_by_id")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdBy Member? @relation("RentComparableAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([listingId])
  @@map("rent_comparables")
  @@schema("app")
}

// ---------------------------------------------------------------------------
// Collaboration
// ---------------------------------------------------------------------------

model Opinion {
  id        String   @id @default(uuid())
  listingId String   @map("listing_id")
  memberId  String   @map("member_id")
  rating    Int      @default(0)
  text      String   @default("")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Lot 20 : première note (un critère ou la note globale) ; null tant que
  /// le membre n'a rien noté (une ligne d'avant le lot 20 se lit par
  /// `rating` et `created_at`).
  ratedAt       DateTime? @map("rated_at") @db.Timestamptz(6)
  /// Lot 20 : les membres dont il avait vu l'avis (« Voir quand même »)
  /// avant sa première note : « après avoir vu celui de … ».
  seenMemberIds String[]  @default([]) @map("seen_member_ids")

  listing Listing        @relation(fields: [listingId], references: [id], onDelete: Cascade)
  member  Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  /// Lot 20 : les notes par critère.
  scores  OpinionScore[]

  @@unique([listingId, memberId])
  @@map("opinions")
  @@schema("app")
}

/// Lot 20 (ADR 0030) : un critère des avis de l'espace. Clé stable unique
/// dans l'espace (les huit par défaut : luminosity, layout, condition, quiet,
/// outdoor, building, street, feel ; un ajout : `custom_…`), libellé et aide
/// renommables, ordre, masqué (retiré des fiches et des calculs, ses notes
/// restent). Un espace sans ligne a les huit par défaut ; les lignes
/// s'écrivent au premier réglage. Dix critères au plus (règle de `domain`).
model OpinionCriterion {
  id          String                 @id @default(uuid())
  workspaceId String                 @map("workspace_id")
  key         String
  label       String
  hint        String                 @default("")
  position    Int
  hidden      Boolean                @default(false)
  origin      OpinionCriterionOrigin @default(custom)
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
  @@map("opinion_criteria")
  @@schema("app")
}

/// Lot 20 : la note d'un critère dans un avis, de 1 à 5 (contrainte en
/// base) ; null = « — » avec un mot seulement ; pas de ligne = pas d'avis.
/// La clé est celle du critère de l'espace (masqué compris).
model OpinionScore {
  id           String   @id @default(uuid())
  opinionId    String   @map("opinion_id")
  criterionKey String   @map("criterion_key")
  score        Int?
  word         String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  opinion Opinion @relation(fields: [opinionId], references: [id], onDelete: Cascade)

  @@unique([opinionId, criterionKey])
  @@index([criterionKey])
  @@map("opinion_scores")
  @@schema("app")
}

/// Lot 20 : « Voir quand même » : un membre qui n'a pas encore noté a choisi
/// de voir l'avis des autres sur une annonce (avis à l'aveugle). Une ligne
/// par annonce et membre ; `memberIds` : les avis visibles à ce moment.
model OpinionReveal {
  id         String   @id @default(uuid())
  listingId  String   @map("listing_id")
  memberId   String   @map("member_id")
  revealedAt DateTime @default(now()) @map("revealed_at") @db.Timestamptz(6)
  memberIds  String[] @default([]) @map("member_ids")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  member  Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([listingId, memberId])
  @@map("opinion_reveals")
  @@schema("app")
}

model Task {
  id         String     @id @default(uuid())
  listingId  String     @map("listing_id")
  label      String
  done       Boolean    @default(false)
  doneAt     DateTime?  @map("done_at") @db.Timestamptz(6)
  assigneeId String?    @map("assignee_id")
  origin     TaskOrigin @default(manual)
  position   Int        @default(0)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Lot 17 : le champ de la fiche que la tâche demande à l'annonceur
  /// (ListingQuestionFieldSchema : annualCharges, propertyTax…), null sinon.
  field       String?
  /// Lot 17 : envoi de la demande qui la porte, cette demande, et la réponse
  /// qui l'a cochée.
  requestedAt DateTime? @map("requested_at") @db.Timestamptz(6)
  requestId   String?   @map("request_id")
  answeredAt  DateTime? @map("answered_at") @db.Timestamptz(6)
  /// Lot 20 : le contexte de la tâche (proposée depuis « Nos avis » : les
  /// notes et les mots qui s'écartent) ; null sinon.
  details     String?

  listing  Listing        @relation(fields: [listingId], references: [id], onDelete: Cascade)
  assignee Member?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  visit    Visit?         @relation("VisitPrepTask")
  request  AgencyRequest? @relation("TaskRequest", fields: [requestId], references: [id], onDelete: SetNull)

  @@index([listingId])
  @@map("tasks")
  @@schema("app")
}

model PriceEvent {
  id         String      @id @default(uuid())
  listingId  String      @map("listing_id")
  occurredAt DateTime    @default(now()) @map("occurred_at") @db.Timestamptz(6)
  oldPrice   Decimal?    @map("old_price") @db.Decimal(12, 2)
  newPrice   Decimal     @map("new_price") @db.Decimal(12, 2)
  source     FieldSource @default(user)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, occurredAt])
  @@map("price_events")
  @@schema("app")
}

/// Offre d'achat et réponse du vendeur (besoin S5). Jamais supprimée : une
/// offre refusée reste dans l'historique de la négociation.
model Offer {
  id            String        @id @default(uuid())
  listingId     String        @map("listing_id")
  madeAt        DateTime      @default(now()) @map("made_at") @db.Timestamptz(6)
  amount        Decimal       @db.Decimal(12, 2)
  channel       OfferChannel?
  response      OfferResponse @default(pending)
  counterAmount Decimal?      @map("counter_amount") @db.Decimal(12, 2)
  respondedAt   DateTime?     @map("responded_at") @db.Timestamptz(6)
  notes         String?
  createdById   String?       @map("created_by_id")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdBy Member? @relation("OfferAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([listingId])
  @@map("offers")
  @@schema("app")
}

/// Visite d'une annonce (besoin S4) : faite ou planifiée, participants
/// (identifiants des membres), compte rendu, points positifs et négatifs,
/// note. Les photos sont des lignes `VisitPhoto` (objets privés dans
/// Supabase Storage).
model Visit {
  id             String      @id @default(uuid())
  listingId      String      @map("listing_id")
  visitedAt      DateTime    @map("visited_at") @db.Timestamptz(6)
  status         VisitStatus @default(done)
  participantIds String[]    @default([]) @map("participants")
  report         String?
  pros           String?
  cons           String?
  rating         Int         @default(0)
  prepTaskId     String?     @unique @map("prep_task_id")
  createdById    String?     @map("created_by_id")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  listing   Listing      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdBy Member?      @relation("VisitAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  prepTask  Task?        @relation("VisitPrepTask", fields: [prepTaskId], references: [id], onDelete: SetNull)
  photos    VisitPhoto[]

  @@index([listingId, visitedAt])
  @@map("visits")
  @@schema("app")
}

/// Une photo de visite : l'objet et sa vignette dans le bucket privé, sous
/// `<espace>/<annonce>/<visite>/`. Lue par URL signée à durée courte ;
/// supprimée par son auteur seulement.
model VisitPhoto {
  id                   String           @id @default(uuid())
  visitId              String           @map("visit_id")
  workspaceId          String           @map("workspace_id")
  status               VisitPhotoStatus @default(pending)
  storagePath          String           @unique @map("storage_path")
  thumbnailPath        String           @unique @map("thumbnail_path")
  contentType          String           @map("content_type")
  sizeBytes            Int              @map("size_bytes")
  thumbnailContentType String           @map("thumbnail_content_type")
  thumbnailSizeBytes   Int              @map("thumbnail_size_bytes")
  width                Int?
  height               Int?
  caption              String?
  uploadedById         String?          @map("uploaded_by_id")
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  readyAt              DateTime?        @map("ready_at") @db.Timestamptz(6)

  visit      Visit     @relation(fields: [visitId], references: [id], onDelete: Cascade)
  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploadedBy Member?   @relation("VisitPhotoAuthor", fields: [uploadedById], references: [id], onDelete: SetNull)
  /// Lot 25 : les annonces dont elle est la couverture choisie.
  coverOf    Listing[] @relation("ListingCover")

  @@index([visitId])
  @@map("visit_photos")
  @@schema("app")
}

/// Une vérification d'annonce sur le portail (lot 15, ADR 0025) : ce que
/// Claude (au MCP) ou un membre (dans le web) a constaté sur la page, ce qui
/// a été appliqué à la fiche ou seulement proposé. Le serveur ne télécharge
/// jamais la page. Jamais supprimée, sauf avec l'annonce.
model ListingCheck {
  id              String              @id @default(uuid())
  listingId       String              @map("listing_id")
  workspaceId     String              @map("workspace_id")
  checkedAt       DateTime            @default(now()) @map("checked_at") @db.Timestamptz(6)
  authorId        String?             @map("author_id")
  channel         ActivityChannel
  outcome         ListingCheckOutcome
  /// Écarts : [{ field, label, before, after, disposition, text }]
  /// (ListingCheckChangeSchema), appliqués, proposés ou notés.
  changes         Json                @default("[]")
  summary         String
  /// Extrait-preuve, 500 caractères au plus, téléphones et e-mails masqués.
  evidence        String?
  checkedUrl      String?             @map("checked_url")
  /// Annonce rattachée par une republication.
  linkedListingId String?             @map("linked_listing_id")
  /// Statut proposé, jamais appliqué d'office.
  suggestedStatus ListingStatus?      @map("suggested_status")
  /// Lot 18 : le lien vérifié (null : annonce sans lien, ou lien retiré depuis).
  linkId          String?             @map("link_id")

  listing       Listing        @relation("ListingChecks", fields: [listingId], references: [id], onDelete: Cascade)
  link          ListingLink?   @relation(fields: [linkId], references: [id], onDelete: SetNull)
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author        Member?        @relation("ListingCheckAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  linkedListing Listing?       @relation("ListingCheckLinked", fields: [linkedListingId], references: [id], onDelete: SetNull)
  mergedDrafts  ListingDraft[]

  @@index([listingId, checkedAt(sort: Desc)])
  @@index([workspaceId, checkedAt(sort: Desc)])
  @@map("listing_checks")
  @@schema("app")
}

/// Qui a changé quoi, quand, par quel canal.
model ActivityLog {
  id            String          @id @default(uuid())
  workspaceId   String          @map("workspace_id")
  listingId     String?         @map("listing_id")
  actorMemberId String?         @map("actor_member_id")
  channel       ActivityChannel @default(web)
  action        String
  before        Json?
  after         Json?
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  listing       Listing?       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  actor         Member?        @relation(fields: [actorMemberId], references: [id], onDelete: SetNull)
  notifications Notification[]

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([listingId, createdAt(sort: Desc)])
  @@map("activity_logs")
  @@schema("app")
}

// ---------------------------------------------------------------------------
// Notifications (lot 6)
// ---------------------------------------------------------------------------

/// Une notification pour un membre, née d'une écriture journalisée. Le
/// texte est figé à la création (il part tel quel en push et par e-mail).
model Notification {
  id          String           @id @default(uuid())
  workspaceId String           @map("workspace_id")
  recipientId String           @map("recipient_id")
  type        NotificationType
  title       String
  body        String
  url         String?
  listingId   String?          @map("listing_id")
  activityId  String?          @map("activity_id")
  actorName   String?          @map("actor_name")
  /// Visible dans la cloche (préférence « dans l'application »).
  inApp       Boolean          @default(true) @map("in_app")
  pushStatus  DeliveryStatus   @default(skipped) @map("push_status")
  emailStatus DeliveryStatus   @default(skipped) @map("email_status")
  readAt      DateTime?        @map("read_at") @db.Timestamptz(6)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  recipient Member       @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  listing   Listing?     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  activity  ActivityLog? @relation(fields: [activityId], references: [id], onDelete: SetNull)

  @@index([recipientId, createdAt(sort: Desc)])
  @@index([pushStatus, createdAt])
  @@index([emailStatus, createdAt])
  @@map("notifications")
  @@schema("app")
}

/// Un abonnement Web Push d'un appareil (PWA). Supprimé quand le service
/// push répond qu'il a expiré (404 ou 410).
model PushSubscription {
  id            String    @id @default(uuid())
  memberId      String    @map("member_id")
  endpoint      String    @unique
  p256dh        String
  auth          String
  userAgent     String?   @map("user_agent")
  failureCount  Int       @default(0) @map("failure_count")
  lastSuccessAt DateTime? @map("last_success_at") @db.Timestamptz(6)
  lastFailureAt DateTime? @map("last_failure_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@map("push_subscriptions")
  @@schema("app")
}

/// Une annonce reçue (alerte e-mail transférée) ou trouvée par Claude en
/// explorant les portails (lot 16) à valider : la fiche pré-remplie (JSON
/// validé par ListingInputSchema), les doublons probables à la réception,
/// puis la décision d'un membre.
model ListingDraft {
  id           String         @id @default(uuid())
  workspaceId  String         @map("workspace_id")
  origin       DraftOrigin    @default(email)
  status       DraftStatus    @default(pending)
  extractedBy  DraftExtractor @map("extracted_by")
  input        Json           @map("listing_input")
  duplicates   Json           @default("[]")
  warnings     Json           @default("[]")
  url          String?
  emailSubject String?        @map("email_subject")
  emailFrom    String?        @map("email_from")
  receivedAt   DateTime       @default(now()) @map("received_at") @db.Timestamptz(6)
  decidedAt    DateTime?      @map("decided_at") @db.Timestamptz(6)
  decidedById  String?        @map("decided_by_id")
  listingId    String?        @map("listing_id")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  // Lot 16 : exploration des portails par Claude.
  explorationId     String?            @map("exploration_id")
  portal            ExplorationPortal?
  /// Ce que Claude a lu, 500 caractères au plus, téléphones et e-mails masqués.
  excerpt           String?
  /// Raison de l'écart (facultative) : un brouillon écarté n'est jamais reproposé.
  dismissReason     String?            @map("dismiss_reason")
  /// « C'en est une autre » : les doublons probables ne sont plus proposés.
  distinctAt        DateTime?          @map("distinct_at") @db.Timestamptz(6)
  /// « C'est la même » : la vérification enregistrée sur l'annonce suivie.
  mergedCheckId     String?            @map("merged_check_id")
  /// Comment le repère a été placé à la lecture (JSON validé par
  /// ListingPlacementSchema), pour l'adéquation calculée à la lecture.
  locationPlacement Json?              @map("location_placement")
  // Lot 18 : lien rattaché d'office (même agence, même référence) à
  // l'annonce `listing_id` ; « Ce n'est pas la même » le détache.
  attachedLinkId    String?            @map("attached_link_id")
  attachedAt        DateTime?          @map("attached_at") @db.Timestamptz(6)
  detachedAt        DateTime?          @map("detached_at") @db.Timestamptz(6)
  /// Lot 31 : dernière écriture sur le brouillon (garde-fou `expectedUpdatedAt`).
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Lot 31 : le brouillon gardé qui a absorbé celui-ci (deux brouillons du
  /// même bien fusionnés) ; son lien rejoint l'annonce créée depuis le gardé.
  mergedIntoDraftId String?            @map("merged_into_draft_id")

  workspace         Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  decidedBy         Member?                @relation("DraftDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  attachedLink      ListingLink?           @relation(fields: [attachedLinkId], references: [id], onDelete: SetNull)
  listing           Listing?               @relation(fields: [listingId], references: [id], onDelete: SetNull)
  exploration       Exploration?           @relation(fields: [explorationId], references: [id], onDelete: SetNull)
  mergedCheck       ListingCheck?          @relation(fields: [mergedCheckId], references: [id], onDelete: SetNull)
  mergedIntoDraft   ListingDraft?          @relation("DraftMerged", fields: [mergedIntoDraftId], references: [id], onDelete: SetNull)
  absorbedDrafts    ListingDraft[]         @relation("DraftMerged")
  lines             ExplorationCandidate[]
  /// Lot 21 : les décisions à plusieurs sur ce brouillon.
  decisionProposals DecisionProposal[]

  @@index([workspaceId, status, createdAt])
  @@index([workspaceId, url])
  @@index([mergedIntoDraftId])
  @@map("listing_drafts")
  @@schema("app")
}

// ---------------------------------------------------------------------------
// Décisions à plusieurs (lot 21, ADR 0031)
// ---------------------------------------------------------------------------

/// Une proposition : garder ou écarter un brouillon, passer une annonce À
/// visiter, écarter une annonce. Elle vise soit une annonce, soit un brouillon
/// (contrainte CHECK dans la migration), au plus une ouverte par cible (index
/// uniques partiels dans la migration, que Prisma ne décrit pas).
model DecisionProposal {
  id            String              @id @default(uuid())
  workspaceId   String              @map("workspace_id")
  listingId     String?             @map("listing_id")
  draftId       String?             @map("draft_id")
  authorId      String?             @map("author_id")
  choice        DecisionChoice
  reason        String?
  state         DecisionState       @default(open)
  /// Le statut de l'annonce à la proposition : la décision est caduque s'il change.
  fromStatus    ListingStatus?      @map("from_status")
  /// La session de tri ; null pour une proposition faite hors session (fiche, MCP).
  sessionId     String?             @map("session_id")
  channel       ActivityChannel     @default(web)
  /// Les autres membres ont été prévenus (session terminée, ou proposition hors session).
  notifiedAt    DateTime?           @map("notified_at") @db.Timestamptz(6)
  resolution    DecisionResolution?
  appliedChoice DecisionChoice?     @map("applied_choice")
  closedAt      DateTime?           @map("closed_at") @db.Timestamptz(6)
  closedById    String?             @map("closed_by_id")
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  listing   Listing?           @relation(fields: [listingId], references: [id], onDelete: Cascade)
  draft     ListingDraft?      @relation(fields: [draftId], references: [id], onDelete: Cascade)
  author    Member?            @relation("DecisionAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  closedBy  Member?            @relation("DecisionCloser", fields: [closedById], references: [id], onDelete: SetNull)
  responses DecisionResponse[]

  @@index([workspaceId, state])
  @@index([listingId])
  @@index([draftId])
  @@index([authorId, sessionId])
  @@map("decision_proposals")
  @@schema("app")
}

/// La réponse d'un membre à une proposition (une au plus par membre).
model DecisionResponse {
  id         String          @id @default(uuid())
  proposalId String          @map("proposal_id")
  memberId   String          @map("member_id")
  agrees     Boolean
  /// Le choix à la place, quand le membre n'est pas d'accord.
  choice     DecisionChoice?
  reason     String?
  /// La session de tri de ce membre ; null hors session (fiche).
  sessionId  String?         @map("session_id")
  /// Le retour de cette réponse à l'auteur est parti.
  notifiedAt DateTime?       @map("notified_at") @db.Timestamptz(6)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  proposal DecisionProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  member   Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([proposalId, memberId])
  @@index([memberId, sessionId])
  @@map("decision_responses")
  @@schema("app")
}

// ---------------------------------------------------------------------------
// Critères de recherche géographiques
// ---------------------------------------------------------------------------

model SearchCriteria {
  id          String  @id @default(uuid())
  workspaceId String  @map("workspace_id")
  createdById String? @map("created_by_id")
  name        String
  active      Boolean @default(true)
  /// JSON validé par CriteriaFiltersSchema
  filters     Json    @default("{}")
  /// Marge de tolérance (lot 14), JSON validé par CriteriaToleranceSchema ;
  /// un champ absent prend la valeur par défaut.
  tolerance   Json    @default("{}")
  /// Portails que Claude parcourt pour ce critère (lot 16), JSON : liste
  /// d'identifiants (CriteriaPortalsSchema) ; null = tous.
  portals     Json?

  perimeterType    PerimeterType?                           @map("perimeter_type")
  /// Point et rayon
  centerLatitude   Float?                                   @map("center_latitude")
  centerLongitude  Float?                                   @map("center_longitude")
  radiusMeters     Int?                                     @map("radius_meters")
  /// Polygone (dessiné ou isochrone figée) ; écrit et lu par le module geo.
  perimeter        Unsupported("geography(Polygon, 4326)")?
  perimeterGeoJson Json?                                    @map("perimeter_geojson")
  isochroneParams  Json?                                    @map("isochrone_params")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy Member?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  matches   CriteriaMatch[]

  @@index([workspaceId])
  @@map("search_criteria")
  @@schema("app")
}

/// L'adéquation d'une annonce à un critère actif (lot 14) : une ligne par
/// (critère actif, annonce), à tout niveau ; « hors critères » compris. Mise
/// à jour à chaque écriture d'annonce, de critère ou d'hypothèses et par le
/// rattrapage (`refresh:criteria-fit`). Une ligne non « hors critères » est
/// une entrée : alerte, badge, `criteriaMatches` des annonces.
model CriteriaMatch {
  criteriaId     String           @map("criteria_id")
  listingId      String           @map("listing_id")
  /// Date de la dernière entrée (passage à un niveau autre que « hors critères »).
  matchedAt      DateTime         @default(now()) @map("matched_at") @db.Timestamptz(6)
  /// À confirmer à cause de la localisation (adresse au quartier ou à la commune).
  approximate    Boolean          @default(false)
  level          CriteriaFitLevel @default(in)
  /// Raisons chiffrées (JSON : tableau de textes).
  reasons        Json             @default("[]")
  /// Le détail filtre par filtre (JSON validé par CriteriaFitCheckSchema).
  checks         Json             @default("[]")
  /// Date du dernier changement de niveau.
  levelChangedAt DateTime         @default(now()) @map("level_changed_at") @db.Timestamptz(6)

  criteria SearchCriteria @relation(fields: [criteriaId], references: [id], onDelete: Cascade)
  listing  Listing        @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([criteriaId, listingId])
  @@index([listingId])
  @@index([criteriaId, level])
  @@map("criteria_matches")
  @@schema("app")
}

// ---------------------------------------------------------------------------
// Données ouvertes importées
// ---------------------------------------------------------------------------

/// Arrêts de tram et de bus (import TBM). `line` liste les lignes qui
/// desservent l'arrêt, séparées par des virgules (« A, C »).
model TransitStop {
  id         String                                 @id @default(uuid())
  network    String
  mode       TransitMode                            @default(bus)
  line       String?
  name       String
  externalId String?                                @map("external_id")
  latitude   Float
  longitude  Float
  geom       Unsupported("geography(Point, 4326)")?
  importedAt DateTime                               @default(now()) @map("imported_at") @db.Timestamptz(6)

  @@unique([network, externalId])
  @@index([network, line])
  @@index([mode])
  @@map("transit_stops")
  @@schema("app")
}

/// Ventes DVF (import Gironde, filtré sur Bordeaux Métropole) : une ligne par
/// mutation ne portant qu'un appartement. `externalId` est l'identifiant de
/// mutation (id_mutation) ; l'import est un upsert idempotent sur cette clé.
model DvfSale {
  id             String                                 @id @default(uuid())
  externalId     String?                                @unique @map("external_id")
  mutationDate   DateTime                               @map("mutation_date") @db.Date
  mutationNature String?                                @map("mutation_nature")
  price          Decimal                                @db.Decimal(12, 2)
  surface        Decimal?                               @db.Decimal(8, 2)
  propertyType   String                                 @map("property_type")
  rooms          Int?
  address        String?
  postalCode     String?                                @map("postal_code")
  commune        String?
  inseeCode      String?                                @map("insee_code")
  latitude       Float?
  longitude      Float?
  geom           Unsupported("geography(Point, 4326)")?
  pricePerM2     Decimal?                               @map("price_per_m2") @db.Decimal(10, 2)
  source         String?
  importedAt     DateTime                               @default(now()) @map("imported_at") @db.Timestamptz(6)

  @@index([inseeCode, mutationDate])
  @@index([mutationDate])
  @@map("dvf_sales")
  @@schema("app")
}

/// Secteurs de l'encadrement des loyers (zonage de l'observatoire local des
/// loyers de Bordeaux, un polygone par IRIS) ; la zone se lit dans le module
/// geo. Les loyers de référence par arrêté sont dans ReferenceData (sorte
/// `rent_reference`).
model RentControlZone {
  id         String                                        @id @default(uuid())
  territory  String
  zone       Int
  label      String
  irisCode   String                                        @map("iris_code")
  inseeCode  String                                        @map("insee_code")
  geom       Unsupported("geography(MultiPolygon, 4326)")?
  source     String?
  importedAt DateTime                                      @default(now()) @map("imported_at") @db.Timestamptz(6)

  @@unique([territory, irisCode])
  @@index([territory, zone])
  @@map("rent_control_zones")
  @@schema("app")
}

/// Équipements de proximité (lot 11) : pistes d'athlétisme (recensement des
/// équipements sportifs du ministère des Sports), supermarchés avec drive et
/// salles Fitness Park (OpenStreetMap). Une ligne par objet de la source ;
/// l'import remplace toutes les lignes d'un couple (genre, source) dans une
/// transaction. `details` porte les attributs propres au genre (nature,
/// couverture, longueur, accès, preuve du drive), validés par
/// `AmenityDetailsSchema` à la lecture.
model Amenity {
  id              String                                 @id @default(uuid())
  kind            AmenityKind
  /// Source : `res` (ministère des Sports) ou `osm` (OpenStreetMap).
  source          String
  /// Identifiant dans la source (numéro d'équipement RES, `node/123` OSM).
  externalId      String                                 @map("external_id")
  name            String
  /// Enseigne telle que la source la nomme (« Carrefour Market »).
  brand           String?
  /// Groupe d'enseigne : carrefour, auchan, intermarche ou other.
  brandGroup      String?                                @map("brand_group")
  drive           DriveStatus?
  address         String?
  commune         String?
  inseeCode       String?                                @map("insee_code")
  details         Json                                   @default("{}")
  latitude        Float
  longitude       Float
  geom            Unsupported("geography(Point, 4326)")?
  /// Date de mise à jour de l'objet dans la source, quand elle la donne.
  sourceUpdatedAt DateTime?                              @map("source_updated_at") @db.Date
  importedAt      DateTime                               @default(now()) @map("imported_at") @db.Timestamptz(6)

  @@unique([kind, source, externalId])
  @@index([kind, brandGroup])
  @@map("amenities")
  @@schema("app")
}

/// Contours des quartiers de Bordeaux Métropole (lot 11) : quartiers
/// officiels là où la commune en publie, IRIS de l'INSEE ailleurs, commune
/// entière pour une commune non découpée. `source` dit d'où vient chaque
/// contour ; l'import remplace tout le territoire dans une transaction.
model Neighbourhood {
  id         String                                        @id @default(uuid())
  territory  String
  kind       NeighbourhoodKind
  /// Identifiant dans la source (code IRIS, identifiant du quartier).
  code       String
  name       String
  /// Quartier plus large qui le contient (quartier administratif d'un
  /// secteur de vie de Bordeaux), si la source le donne.
  parent     String?
  commune    String
  inseeCode  String                                        @map("insee_code")
  source     String
  geom       Unsupported("geography(MultiPolygon, 4326)")?
  /// Ce que la carte dessine : le contour entier, ou pour l'IRIS d'une
  /// commune à quartiers officiels la seule part hors de ces quartiers
  /// (morceaux d'au moins 1 ha une fois rognés de 25 m : pas les liserés),
  /// null si rien n'est à dessiner. Calculé par
  /// l'import (module geo).
  mapGeom    Unsupported("geography(MultiPolygon, 4326)")? @map("map_geom")
  importedAt DateTime                                      @default(now()) @map("imported_at") @db.Timestamptz(6)

  @@unique([territory, code])
  @@index([territory, inseeCode])
  @@map("neighbourhoods")
  @@schema("app")
}

/// Lieux-dits OpenStreetMap (lot 12) : `place=neighbourhood`, `quarter` ou
/// `suburb`, un point par objet, rattaché à la commune dont un contour
/// importé le contient. Repli du placement d'une annonce au quartier quand
/// aucun contour ne porte le nom cité.
model Place {
  id         String                                 @id @default(uuid())
  /// Source : `osm`.
  source     String
  /// Identifiant dans la source (`node/123`, `relation/456`).
  externalId String                                 @map("external_id")
  name       String
  /// Valeur de `place` : neighbourhood, quarter ou suburb.
  placeType  String                                 @map("place_type")
  commune    String?
  inseeCode  String?                                @map("insee_code")
  latitude   Float
  longitude  Float
  geom       Unsupported("geography(Point, 4326)")?
  importedAt DateTime                               @default(now()) @map("imported_at") @db.Timestamptz(6)

  @@unique([source, externalId])
  @@index([inseeCode])
  @@map("places")
  @@schema("app")
}

/// Données de référence datées (loyers de référence, calendrier DPE, barème
/// notaire) et cache des appels open data.
model ReferenceData {
  id        String    @id @default(uuid())
  kind      String
  key       String
  validFrom DateTime? @map("valid_from") @db.Date
  payload   Json
  fetchedAt DateTime  @default(now()) @map("fetched_at") @db.Timestamptz(6)

  @@unique([kind, key])
  @@map("reference_data")
  @@schema("app")
}

// ---------------------------------------------------------------------------
// Exploration par les critères (lot 16, ADR 0026)
// ---------------------------------------------------------------------------

/// Portail où Claude a lu une annonce.
enum ExplorationPortal {
  leboncoin
  seloger
  bienici
  pap
  logicimmo
  other

  @@schema("app")
}

/// Résultat du tri d'une annonce lue : nouvelle (brouillon), doublon
/// probable (brouillon à trancher), déjà suivie (vérification), déjà
/// écartée, hors critères (ligne du compte rendu seulement).
enum ExplorationOutcome {
  new
  duplicate_probable
  known
  dismissed
  out
  /// Lot 18 : même agence et même référence qu'une annonce suivie : lien rattaché d'office.
  attached

  @@schema("app")
}

/// Une exploration des portails par Claude, dans le navigateur de
/// l'utilisateur : ce qu'il a lu, trié de nouveau par le serveur. Le serveur
/// ne télécharge jamais une page. `run_key` rend l'enregistrement idempotent.
model Exploration {
  id          String          @id @default(uuid())
  workspaceId String          @map("workspace_id")
  /// Le membre pour qui Claude a exploré.
  authorId    String?         @map("author_id")
  channel     ActivityChannel @default(mcp)
  runKey      String          @map("run_key")
  startedAt   DateTime        @map("started_at") @db.Timestamptz(6)
  finishedAt  DateTime        @map("finished_at") @db.Timestamptz(6)
  /// Les critères explorés : [{ id, name }].
  criteria    Json            @default("[]")
  /// Le bilan de chaque portail (ExplorationPortalRunSchema).
  portals     Json            @default("[]")
  /// Les compteurs (ExplorationCountsSchema).
  counts      Json            @default("{}")
  summary     String
  /// Les raisons des hors critères, regroupées.
  outDigest   String?         @map("out_digest")
  notes       String?
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author    Member?                @relation("ExplorationAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  lines     ExplorationCandidate[]
  drafts    ListingDraft[]

  @@unique([workspaceId, runKey])
  @@index([workspaceId, finishedAt(sort: Desc)])
  @@map("explorations")
  @@schema("app")
}

/// Une ligne du compte rendu : une annonce lue et ce qu'il en est advenu.
/// Une annonce hors critères n'existe qu'ici (ni annonce ni brouillon).
model ExplorationCandidate {
  id            String             @id @default(uuid())
  explorationId String             @map("exploration_id")
  position      Int
  url           String
  /// Le lien réduit à ce qui identifie l'annonce (normalizeListingUrl).
  normalizedUrl String?            @map("normalized_url")
  portal        ExplorationPortal
  title         String
  price         Decimal?           @db.Decimal(12, 2)
  surface       Decimal?           @db.Decimal(8, 2)
  rooms         Int?
  commune       String?
  district      String?
  outcome       ExplorationOutcome
  /// La phrase du compte rendu (« Même lien : prix … → …, appliqué »).
  why           String
  /// Raisons chiffrées de l'adéquation (JSON : tableau de textes).
  reasons       Json               @default("[]")
  level         CriteriaFitLevel?
  listingId     String?            @map("listing_id")
  draftId       String?            @map("draft_id")
  /// Extrait lu, 500 caractères au plus, téléphones et e-mails masqués.
  excerpt       String?

  exploration Exploration   @relation(fields: [explorationId], references: [id], onDelete: Cascade)
  listing     Listing?      @relation(fields: [listingId], references: [id], onDelete: SetNull)
  draft       ListingDraft? @relation(fields: [draftId], references: [id], onDelete: SetNull)

  @@index([explorationId, position])
  @@index([normalizedUrl])
  @@map("exploration_candidates")
  @@schema("app")
}

// ---------------------------------------------------------------------------
// Lot 17 : questions aux agences (ADR 0027)
// ---------------------------------------------------------------------------

/// Canal d'une demande à l'annonceur.
enum AgencyChannel {
  email
  portal_message
  phone
  other

  @@schema("app")
}

/// Cycle d'une demande : brouillon à valider, validée, envoyée (par Claude
/// ou un membre, jamais par le serveur), réponse reçue, sans réponse, annulée.
enum AgencyRequestStatus {
  draft
  approved
  sent
  answered
  no_answer
  cancelled

  @@schema("app")
}

/// Où l'envoi a été validé : dans l'application, ou dans la conversation.
enum AgencyApprovalVia {
  app
  chat

  @@schema("app")
}

/// Le contact de l'annonceur d'une annonce : données personnelles de tiers,
/// minimales (ce que l'annonce donne), modifiables et effaçables dans
/// l'application ; jamais supprimées par le MCP. Le journal n'en garde que
/// les noms des champs changés.
model ListingContact {
  listingId        String         @id @map("listing_id")
  workspaceId      String         @map("workspace_id")
  agencyName       String?        @map("agency_name")
  contactName      String?        @map("contact_name")
  email            String?
  phone            String?
  portalMessageUrl String?        @map("portal_message_url")
  preferredChannel AgencyChannel? @map("preferred_channel")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById      String?        @map("updated_by_id")

  listing   Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  updatedBy Member?   @relation("ListingContactEditor", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@map("listing_contacts")
  @@schema("app")
}

/// Une demande à l'annonceur : le message (objet, texte), les tâches qu'il
/// pose, sa validation (par un membre, dans l'application ou la
/// conversation), son envoi (par Claude avec les outils de l'utilisateur, ou
/// par un membre ; jamais par le serveur), la référence du fil, les réponses
/// (extrait court masqué, valeurs appliquées ou proposées). Jamais
/// supprimée, sauf avec l'annonce.
model AgencyRequest {
  id            String              @id @default(uuid())
  workspaceId   String              @map("workspace_id")
  listingId     String              @map("listing_id")
  status        AgencyRequestStatus @default(draft)
  channel       AgencyChannel
  /// Destinataire, nom affiché seulement.
  recipientName String?             @map("recipient_name")
  subject       String
  body          String
  /// Tâches posées par le message.
  taskIds       String[]            @default([]) @map("task_ids")
  createdById   String?             @map("created_by_id")
  createdVia    ActivityChannel     @default(web) @map("created_via")
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  approvedAt    DateTime?           @map("approved_at") @db.Timestamptz(6)
  approvedVia   AgencyApprovalVia?  @map("approved_via")
  approvedById  String?             @map("approved_by_id")
  sentAt        DateTime?           @map("sent_at") @db.Timestamptz(6)
  sentById      String?             @map("sent_by_id")
  /// Identifiant de fil Gmail ou lien de la conversation sur le portail.
  threadRef     String?             @map("thread_ref")
  /// Dernière réponse reçue.
  answeredAt    DateTime?           @map("answered_at") @db.Timestamptz(6)
  /// Réponses : [{ receivedAt, recordedAt, authorId, channel, excerpt,
  /// values, changes, completedTaskIds, summary }] (AgencyAnswerSchema).
  answers       Json                @default("[]")
  /// Annulation ou « pas de réponse ».
  closedAt      DateTime?           @map("closed_at") @db.Timestamptz(6)
  /// La demande que celle-ci relance.
  followUpOfId  String?             @map("follow_up_of_id")

  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  listing      Listing         @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdBy    Member?         @relation("AgencyRequestAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy   Member?         @relation("AgencyRequestApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  sentBy       Member?         @relation("AgencyRequestSender", fields: [sentById], references: [id], onDelete: SetNull)
  followUpOf   AgencyRequest?  @relation("AgencyRequestFollowUp", fields: [followUpOfId], references: [id], onDelete: SetNull)
  followUps    AgencyRequest[] @relation("AgencyRequestFollowUp")
  carriedTasks Task[]          @relation("TaskRequest")

  @@index([listingId, createdAt(sort: Desc)])
  @@index([workspaceId, status])
  @@map("agency_requests")
  @@schema("app")
}

// ---------------------------------------------------------------------------
// Lot 18 : une annonce, plusieurs portails (ADR 0028)
// ---------------------------------------------------------------------------

/// Un lien d'une annonce sur un portail : la même annonce est souvent
/// publiée sur plusieurs portails. L'URL normalisée est unique dans l'espace
/// (un lien n'appartient qu'à une annonce). Le lien principal (le plus ancien
/// en ligne, à défaut le plus ancien) est recopié dans `listings.url`,
/// `source` et `external_id`. Le prix de la fiche est le plus bas des liens en
/// ligne dont le prix est connu. Le serveur ne joint jamais un portail.
model ListingLink {
  id               String            @id @default(uuid())
  workspaceId      String            @map("workspace_id")
  listingId        String            @map("listing_id")
  portal           ListingPortal
  url              String
  /// `normalizeListingUrl` (domain) : https, hôte sans www, chemin, requête
  /// retirée sur un portail connu.
  normalizedUrl    String            @map("normalized_url")
  /// Identifiant de l'annonce sur ce portail (numéro Leboncoin…).
  externalId       String?           @map("external_id")
  /// Prix affiché sur ce portail, et la date du relevé.
  price            Decimal?          @db.Decimal(12, 2)
  priceAt          DateTime?         @map("price_at") @db.Timestamptz(6)
  firstSeenAt      DateTime?         @map("first_seen_at") @db.Timestamptz(6)
  lastSeenOnlineAt DateTime?         @map("last_seen_online_at") @db.Timestamptz(6)
  lastCheckedAt    DateTime?         @map("last_checked_at") @db.Timestamptz(6)
  /// Plus en ligne depuis cette date ; null = en ligne (ou pas encore vérifié).
  offlineSince     DateTime?         @map("offline_since") @db.Timestamptz(6)
  origin           ListingLinkOrigin
  /// L'agence (ou le réseau) et la référence affichées sur ce portail.
  readSellerName   String?           @map("read_seller_name")
  readReference    String?           @map("read_reference")
  /// Extrait court lu à l'ajout (500 caractères, téléphones et e-mails masqués).
  evidence         String?
  addedById        String?           @map("added_by_id")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  listing        Listing        @relation(fields: [listingId], references: [id], onDelete: Cascade)
  addedBy        Member?        @relation("ListingLinkAuthor", fields: [addedById], references: [id], onDelete: SetNull)
  checks         ListingCheck[]
  attachedDrafts ListingDraft[]

  @@unique([workspaceId, normalizedUrl])
  @@index([listingId, createdAt])
  @@map("listing_links")
  @@schema("app")
}

// ---------------------------------------------------------------------------
// Fusion des doublons et agences multiples (lot 27, ADR 0037)
// ---------------------------------------------------------------------------

/// Une autre agence qui vend le même bien (mandat simple), avec sa propre
/// référence. L'agence principale reste sur l'annonce (`seller_type`,
/// `seller_name`, `seller_reference`) ; celles-ci s'y ajoutent. La clé de la
/// référence sert à reconnaître la même annonce sur un autre portail.
model ListingSeller {
  id                 String              @id @default(uuid())
  workspaceId        String              @map("workspace_id")
  listingId          String              @map("listing_id")
  sellerType         SellerType          @default(unknown) @map("seller_type")
  sellerName         String?             @map("seller_name")
  sellerReference    String?             @map("seller_reference")
  sellerReferenceKey String?             @map("seller_reference_key")
  origin             ListingSellerOrigin
  addedById          String?             @map("added_by_id")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  listing   Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  addedBy   Member?   @relation("ListingSellerAuthor", fields: [addedById], references: [id], onDelete: SetNull)

  @@index([listingId, createdAt])
  @@index([workspaceId, sellerReferenceKey])
  @@map("listing_sellers")
  @@schema("app")
}

/// Une fusion de deux fiches du même bien : la fiche gardée, la fiche
/// absorbée, qui, par quel canal, et ce qui est passé de l'une à l'autre
/// (`moved` : identifiants par table, champs complétés, état d'avant), pour
/// l'annuler. Une fusion annulée garde sa ligne (`undone_at`).
model ListingMerge {
  id          String          @id @default(uuid())
  workspaceId String          @map("workspace_id")
  keptId      String          @map("kept_id")
  absorbedId  String          @map("absorbed_id")
  mergedById  String?         @map("merged_by_id")
  channel     ActivityChannel
  mergedAt    DateTime        @default(now()) @map("merged_at") @db.Timestamptz(6)
  summary     String
  /// Ce qui a rejoint la fiche gardée, compté (JSON validé par ListingMergeCountsSchema).
  counts      Json            @default("{}")
  /// Ce qu'il faut pour annuler : identifiants déplacés, champs complétés, état d'avant.
  moved       Json            @default("{}")
  undoneAt    DateTime?       @map("undone_at") @db.Timestamptz(6)
  undoneById  String?         @map("undone_by_id")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  kept      Listing   @relation("ListingMergeKept", fields: [keptId], references: [id], onDelete: Cascade)
  absorbed  Listing   @relation("ListingMergeAbsorbed", fields: [absorbedId], references: [id], onDelete: Cascade)
  mergedBy  Member?   @relation("ListingMergeAuthor", fields: [mergedById], references: [id], onDelete: SetNull)
  undoneBy  Member?   @relation("ListingMergeUndoer", fields: [undoneById], references: [id], onDelete: SetNull)

  @@index([keptId, mergedAt])
  @@index([absorbedId])
  @@map("listing_merges")
  @@schema("app")
}

/// Lot 30 (ADR 0043) : une paire de fiches qui se ressemblent assez pour être
/// le même bien. `pending` : Claude a créé la fiche malgré un doublon probable,
/// l'application demande au membre ; `distinct` : un membre a dit que ce sont
/// deux biens différents (la paire n'est plus signalée). « Oui » fusionne les
/// deux fiches et efface la paire. `listing_a_id` < `listing_b_id` (CHECK).
enum DuplicatePairVerdict {
  pending
  distinct

  @@schema("app")
}

model DuplicatePair {
  id           String               @id @default(uuid())
  workspaceId  String               @map("workspace_id")
  listingAId   String               @map("listing_a_id")
  listingBId   String               @map("listing_b_id")
  verdict      DuplicatePairVerdict
  askedById    String?              @map("asked_by_id")
  askedChannel ActivityChannel      @map("asked_channel")
  decidedById  String?              @map("decided_by_id")
  decidedAt    DateTime?            @map("decided_at") @db.Timestamptz(6)
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  listingA  Listing   @relation("DuplicatePairA", fields: [listingAId], references: [id], onDelete: Cascade)
  listingB  Listing   @relation("DuplicatePairB", fields: [listingBId], references: [id], onDelete: Cascade)
  askedBy   Member?   @relation("DuplicatePairAsker", fields: [askedById], references: [id], onDelete: SetNull)
  decidedBy Member?   @relation("DuplicatePairDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([listingAId, listingBId])
  @@index([listingBId])
  @@index([workspaceId, verdict])
  @@map("duplicate_pairs")
  @@schema("app")
}
