// Modèle de données d'apart-localizer (étude du besoin § 4).
//
// Tout vit dans le schéma Postgres `app`, à l'écart des schémas de Supabase
// (`auth`, `storage`) et hors de l'exposition PostgREST (`public`). Les
// colonnes géographiques sont des `geography` PostGIS déclarées Unsupported,
// doublées de latitude et longitude classiques pour les lectures ordinaires ;
// le SQL qui les manipule vit dans le module `geo` et nulle part ailleurs.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["app"]
}

// ---------------------------------------------------------------------------
// Énumérations (identifiants alignés sur packages/contracts)
// ---------------------------------------------------------------------------

enum MemberRole {
  owner
  member

  @@schema("app")
}

/// Cycle de vie d'une ligne de membre (lot 8, ADR 0018).
enum MemberStatus {
  active
  invited
  canceled
  declined
  removed

  @@schema("app")
}

enum ListingSource {
  seloger
  leboncoin
  pap
  bienici
  agence
  autre

  @@schema("app")
}

enum ListingStatus {
  to_study
  to_visit
  visited
  offer_made
  offer_accepted
  offer_refused
  discarded
  sold_or_withdrawn

  @@schema("app")
}

enum DpeClass {
  A
  B
  C
  D
  E
  F
  G

  @@schema("app")
}

enum FieldSource {
  listing
  user
  ai
  open_data
  estimated

  @@schema("app")
}

enum LocationPrecision {
  exact
  street
  district
  commune

  @@schema("app")
}

enum FeesPayer {
  buyer
  seller

  @@schema("app")
}

enum LeaseType {
  unfurnished
  furnished
  shared

  @@schema("app")
}

enum RentControl {
  auto
  yes
  no

  @@schema("app")
}

enum RenovationLevel {
  refresh
  renovation
  heavy
  energy

  @@schema("app")
}

enum RentalDemand {
  strong
  medium
  weak

  @@schema("app")
}

enum TriState {
  yes
  no
  unknown

  @@schema("app")
}

enum TaskOrigin {
  default
  manual
  missing_field
  visit

  @@schema("app")
}

enum OfferResponse {
  pending
  accepted
  refused
  counter_offer

  @@schema("app")
}

enum OfferChannel {
  email
  phone
  agency
  in_person
  letter
  other

  @@schema("app")
}

enum ActivityChannel {
  web
  mcp
  import
  system

  @@schema("app")
}

enum VisitStatus {
  planned
  done

  @@schema("app")
}

enum VisitPhotoStatus {
  pending
  ready

  @@schema("app")
}

enum NotificationType {
  listing_created
  status_changed
  task_assigned
  criteria_matched
  offer_response
  drafts_received
  member_joined

  @@schema("app")
}

/// État d'envoi d'une notification sur un canal (push, e-mail).
enum DeliveryStatus {
  pending
  sent
  failed
  skipped

  @@schema("app")
}

enum DraftStatus {
  pending
  accepted
  dismissed

  @@schema("app")
}

enum DraftOrigin {
  email

  @@schema("app")
}

enum DraftExtractor {
  ai
  parser

  @@schema("app")
}

enum PerimeterType {
  point_radius
  polygon
  isochrone

  @@schema("app")
}

enum TransitMode {
  tram
  bus
  boat

  @@schema("app")
}

/// Genre d'un équipement de proximité importé (lot 11).
enum AmenityKind {
  athletics_track
  supermarket_drive
  fitness_park

  @@schema("app")
}

/// Drive d'un supermarché : signalé explicitement par la source, ou donnée
/// ambiguë à vérifier. Un magasin sans aucun signal n'est pas importé.
enum DriveStatus {
  yes
  to_verify

  @@schema("app")
}

/// Nature d'un contour de quartier (lot 11) : quartier officiel d'une
/// commune, IRIS de l'INSEE à défaut, ou commune entière.
enum NeighbourhoodKind {
  quartier
  iris
  commune

  @@schema("app")
}

// ---------------------------------------------------------------------------
// Espace de travail et membres
// ---------------------------------------------------------------------------

model Workspace {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  members        Member[]
  listings       Listing[]
  assumptions    AssumptionsVersion[]
  searchCriteria SearchCriteria[]
  activityLogs   ActivityLog[]
  scenarios      Scenario[]
  notifications  Notification[]
  listingDrafts  ListingDraft[]
  visitPhotos    VisitPhoto[]

  @@map("workspaces")
  @@schema("app")
}

/// Un membre peut être créé avant sa première connexion (import des avis de
/// Richard et Chloé) : `authUserId` est alors null et le rattachement se fait
/// par e-mail à la première connexion. Lot 8 : une invitation est une ligne
/// `invited` (sans compte, `invitedAt` renseigné) ; un membre retiré garde sa
/// ligne (`removed`, identité détachée) pour que son historique reste à son
/// nom. Invariant : `authUserId` renseigné ⇒ `status = active`.
model Member {
  id          String       @id @default(uuid())
  workspaceId String       @map("workspace_id")
  handle      String
  displayName String       @map("display_name")
  email       String?
  authUserId  String?      @unique @map("auth_user_id")
  role        MemberRole   @default(member)
  status      MemberStatus @default(active)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Invitation : envoi, auteur, échéance. Null pour un membre pré-créé
  /// (import) ou créé à sa première connexion.
  invitedAt           DateTime? @map("invited_at") @db.Timestamptz(6)
  invitedById         String?   @map("invited_by_id")
  invitationExpiresAt DateTime? @map("invitation_expires_at") @db.Timestamptz(6)
  /// Annulation (par un propriétaire) ou refus (par la personne).
  invitationClosedAt  DateTime? @map("invitation_closed_at") @db.Timestamptz(6)
  /// Première connexion dans l'espace (invitation acceptée, membre pré-créé rattaché).
  joinedAt            DateTime? @map("joined_at") @db.Timestamptz(6)
  /// Retrait par un propriétaire, ou départ (auteur = le membre lui-même).
  removedAt           DateTime? @map("removed_at") @db.Timestamptz(6)
  removedById         String?   @map("removed_by_id")

  /// Dernière activité dans l'application (visite en cours ou passée).
  lastVisitAt             DateTime? @map("last_visit_at") @db.Timestamptz(6)
  /// Point de départ de « ce qui a changé » : fin de la visite précédente
  /// ou « tout marquer comme vu ».
  whatsNewSince           DateTime? @map("whats_new_since") @db.Timestamptz(6)
  /// Origine de ce point de départ (`previous_visit`, `marked_seen`).
  whatsNewSource          String?   @map("whats_new_source")
  /// Préférences de notification par type et par canal (JSON validé par
  /// NotificationPreferencesSchema ; vide = défauts).
  notificationPreferences Json      @default("{}") @map("notification_preferences")

  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  opinions          Opinion[]
  assignedTasks     Task[]             @relation("TaskAssignee")
  listingViews      ListingView[]
  createdListings   Listing[]          @relation("ListingCreator")
  offers            Offer[]            @relation("OfferAuthor")
  searchCriteria    SearchCriteria[]
  activityLogs      ActivityLog[]
  scenarios         Scenario[]         @relation("ScenarioAuthor")
  rentComparables   RentComparable[]   @relation("RentComparableAuthor")
  visits            Visit[]            @relation("VisitAuthor")
  visitPhotos       VisitPhoto[]       @relation("VisitPhotoAuthor")
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  decidedDrafts     ListingDraft[]     @relation("DraftDecider")
  invitedBy         Member?            @relation("MemberInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  invitees          Member[]           @relation("MemberInviter")
  removedBy         Member?            @relation("MemberRemover", fields: [removedById], references: [id], onDelete: SetNull)
  removals          Member[]           @relation("MemberRemover")

  @@unique([workspaceId, handle])
  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([email])
  @@map("members")
  @@schema("app")
}

// ---------------------------------------------------------------------------
// Hypothèses versionnées
// ---------------------------------------------------------------------------

/// Une ligne par version ; la plus récente par `effectiveFrom` est en vigueur.
/// `values` est le JSON validé par `AssumptionsSchema` (taux en fractions).
model AssumptionsVersion {
  id            String   @id @default(uuid())
  workspaceId   String   @map("workspace_id")
  label         String?
  effectiveFrom DateTime @default(now()) @map("effective_from") @db.Timestamptz(6)
  values        Json
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, effectiveFrom(sort: Desc)])
  @@map("assumptions_versions")
  @@schema("app")
}

// ---------------------------------------------------------------------------
// Annonces
// ---------------------------------------------------------------------------

model Listing {
  id          String @id @default(uuid())
  workspaceId String @map("workspace_id")

  // Identité
  source          ListingSource @default(autre)
  sourceLabel     String?       @map("source_label")
  url             String?
  externalId      String?       @map("external_id")
  title           String
  publishedAt     DateTime?     @map("published_at") @db.Timestamptz(6)
  sourceUpdatedAt DateTime?     @map("source_updated_at") @db.Timestamptz(6)
  description     String?
  notes           String?
  sourceText      String?       @map("source_text")

  // Localisation
  addressRaw        String?                                @map("address_raw")
  addressNormalized String?                                @map("address_normalized")
  banId             String?                                @map("ban_id")
  commune           String?
  inseeCode         String?                                @map("insee_code")
  district          String?
  latitude          Float?
  longitude         Float?
  /// Point WGS 84 ; écrit et lu uniquement par le module geo.
  geom              Unsupported("geography(Point, 4326)")?
  locationPrecision LocationPrecision?                     @map("location_precision")
  locationGeoJson   Json?                                  @map("location_geojson")
  /// Comment le repère a été placé (lot 12) : méthode, quartier retenu,
  /// texte reconnu, réserves (JSON validé par ListingPlacementSchema).
  locationPlacement Json?                                  @map("location_placement")
  /// La zone où le bien se trouve d'après l'annonce (contour du quartier
  /// retenu, ou de la commune) quand le repère est approché ; écrite et lue
  /// uniquement par le module geo.
  locationArea      Unsupported("geography(MultiPolygon, 4326)")? @map("location_area")

  // Bien
  price              Decimal    @db.Decimal(12, 2)
  feesAmount         Decimal?   @map("fees_amount") @db.Decimal(12, 2)
  feesPercent        Float?     @map("fees_percent")
  feesPayer          FeesPayer? @map("fees_payer")
  surface            Decimal?   @db.Decimal(8, 2)
  surfaceTotal       Decimal?   @map("surface_total") @db.Decimal(8, 2)
  rooms              Int?
  bedrooms           Int?
  floor              Int?
  floorsTotal        Int?       @map("floors_total")
  floorLabel         String?    @map("floor_label")
  elevator           Boolean?
  constructionYear   Int?       @map("construction_year")
  constructionPeriod String?    @map("construction_period")
  dpeClass           DpeClass?  @map("dpe_class")
  dpeConsumption     Float?     @map("dpe_consumption")
  gesClass           DpeClass?  @map("ges_class")
  dpeDate            DateTime?  @map("dpe_date") @db.Date
  dpeNumber          String?    @map("dpe_number")
  heatingType        String?    @map("heating_type")
  heatingCollective  Boolean?   @map("heating_collective")
  outdoor            String?
  parking            String?
  cellar             Boolean?
  orientation        String?
  condition          String?

  // Copropriété et fiscalité locale
  annualCharges                Decimal? @map("annual_charges") @db.Decimal(12, 2)
  nonRecoverableChargesMonthly Decimal? @map("non_recoverable_charges_monthly") @db.Decimal(10, 2)
  lotsCount                    Int?     @map("lots_count")
  proceedings                  String?
  votedWorks                   String?  @map("voted_works")
  syndic                       String?
  propertyTax                  Decimal? @map("property_tax") @db.Decimal(12, 2)
  furnitureValue               Decimal? @map("furniture_value") @db.Decimal(12, 2)

  // Provenance par champ : { champ: { source, confidence, evidence } }
  fieldSources Json @default("{}") @map("field_sources")

  // Suivi
  status        ListingStatus @default(to_study)
  discardReason String?       @map("discard_reason")
  discardedAt   DateTime?     @map("discarded_at") @db.Timestamptz(6)

  // Surcharge partielle des hypothèses (JSON validé par AssumptionsOverrideSchema)
  assumptionsOverride Json? @map("assumptions_override")

  // Dernier enrichissement open data (JSON validé par ListingOpenDataContextSchema)
  openDataContext Json? @map("open_data_context")

  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy       Member?          @relation("ListingCreator", fields: [createdById], references: [id], onDelete: SetNull)
  renovation      Renovation?
  rentalPlan      RentalPlan?
  opinions        Opinion[]
  tasks           Task[]
  priceEvents     PriceEvent[]
  offers          Offer[]
  visits          Visit[]
  activityLogs    ActivityLog[]
  views           ListingView[]
  criteriaMatches CriteriaMatch[]
  scenarios       Scenario[]
  rentComparables RentComparable[]
  notifications   Notification[]
  drafts          ListingDraft[]

  @@index([workspaceId, status])
  @@index([workspaceId, commune])
  @@index([workspaceId, url])
  @@map("listings")
  @@schema("app")
}

/// « Vu par » : un membre a ouvert l'annonce.
model ListingView {
  listingId String   @map("listing_id")
  memberId  String   @map("member_id")
  seenAt    DateTime @default(now()) @map("seen_at") @db.Timestamptz(6)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  member  Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([listingId, memberId])
  @@index([memberId])
  @@map("listing_views")
  @@schema("app")
}

/// Travaux avant emménagement.
model Renovation {
  id             String           @id @default(uuid())
  listingId      String           @unique @map("listing_id")
  active         Boolean          @default(false)
  level          RenovationLevel?
  durationMonths Int?             @map("duration_months")
  notes          String?

  listing Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  items   RenovationItem[]

  @@map("renovations")
  @@schema("app")
}

model RenovationItem {
  id           String   @id @default(uuid())
  renovationId String   @map("renovation_id")
  label        String
  amount       Decimal? @db.Decimal(12, 2)
  position     Int      @default(0)

  renovation Renovation @relation(fields: [renovationId], references: [id], onDelete: Cascade)

  @@index([renovationId])
  @@map("renovation_items")
  @@schema("app")
}

/// Phase 2 : mise en location. `comparables` (JSON) n'est plus lu depuis le
/// lot 5 : les comparables de loyer sont dans `rent_comparables` (la
/// migration du lot 5 y a recopié les éventuelles lignes) ; colonne gardée
/// pour ne rien perdre, à supprimer plus tard.
model RentalPlan {
  id                      String        @id @default(uuid())
  listingId               String        @unique @map("listing_id")
  year                    Int?
  leaseType               LeaseType     @default(unfurnished) @map("lease_type")
  rentControl             RentControl   @default(auto) @map("rent_control")
  referenceRentPerM2      Decimal?      @map("reference_rent_per_m2") @db.Decimal(8, 2)
  targetRent              Decimal?      @map("target_rent") @db.Decimal(10, 2)
  marketRent              Decimal?      @map("market_rent") @db.Decimal(10, 2)
  comparables             Json          @default("[]")
  demand                  RentalDemand?
  coOwnershipAllowsRental TriState      @default(unknown) @map("co_ownership_allows_rental")
  decencyCompliant        TriState      @default(unknown) @map("decency_compliant")
  rentalPermitRequired    TriState      @default(unknown) @map("rental_permit_required")
  notes                   String?

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@map("rental_plans")
  @@schema("app")
}

/// Scénario « et si » enregistré (besoin E4) : des surcharges de l'annonce et
/// des hypothèses (JSON validé par `ScenarioOverridesSchema`), pour une
/// annonce ou pour tout l'espace (`listingId` null).
model Scenario {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  listingId   String?  @map("listing_id")
  name        String
  overrides   Json     @default("{}")
  notes       String?
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  listing   Listing?  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdBy Member?   @relation("ScenarioAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([listingId])
  @@map("scenarios")
  @@schema("app")
}

/// Annonce de location comparable saisie à la main (besoin L4) : la matière
/// du loyer de marché d'une annonce.
model RentComparable {
  id          String        @id @default(uuid())
  listingId   String        @map("listing_id")
  rent        Decimal       @db.Decimal(10, 2)
  surface     Decimal       @db.Decimal(8, 2)
  furnished   Boolean       @default(false)
  rooms       Int?
  observedAt  DateTime?     @map("observed_at") @db.Date
  source      ListingSource @default(autre)
  sourceLabel String?       @map("source_label")
  url         String?
  address     String?
  note        String?
  createdById String?       @map("created_by_id")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdBy Member? @relation("RentComparableAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([listingId])
  @@map("rent_comparables")
  @@schema("app")
}

// ---------------------------------------------------------------------------
// Collaboration
// ---------------------------------------------------------------------------

model Opinion {
  id        String   @id @default(uuid())
  listingId String   @map("listing_id")
  memberId  String   @map("member_id")
  rating    Int      @default(0)
  text      String   @default("")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  member  Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([listingId, memberId])
  @@map("opinions")
  @@schema("app")
}

model Task {
  id         String     @id @default(uuid())
  listingId  String     @map("listing_id")
  label      String
  done       Boolean    @default(false)
  doneAt     DateTime?  @map("done_at") @db.Timestamptz(6)
  assigneeId String?    @map("assignee_id")
  origin     TaskOrigin @default(manual)
  position   Int        @default(0)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  listing  Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  assignee Member? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  visit    Visit?  @relation("VisitPrepTask")

  @@index([listingId])
  @@map("tasks")
  @@schema("app")
}

model PriceEvent {
  id         String      @id @default(uuid())
  listingId  String      @map("listing_id")
  occurredAt DateTime    @default(now()) @map("occurred_at") @db.Timestamptz(6)
  oldPrice   Decimal?    @map("old_price") @db.Decimal(12, 2)
  newPrice   Decimal     @map("new_price") @db.Decimal(12, 2)
  source     FieldSource @default(user)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, occurredAt])
  @@map("price_events")
  @@schema("app")
}

/// Offre d'achat et réponse du vendeur (besoin S5). Jamais supprimée : une
/// offre refusée reste dans l'historique de la négociation.
model Offer {
  id            String        @id @default(uuid())
  listingId     String        @map("listing_id")
  madeAt        DateTime      @default(now()) @map("made_at") @db.Timestamptz(6)
  amount        Decimal       @db.Decimal(12, 2)
  channel       OfferChannel?
  response      OfferResponse @default(pending)
  counterAmount Decimal?      @map("counter_amount") @db.Decimal(12, 2)
  respondedAt   DateTime?     @map("responded_at") @db.Timestamptz(6)
  notes         String?
  createdById   String?       @map("created_by_id")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdBy Member? @relation("OfferAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([listingId])
  @@map("offers")
  @@schema("app")
}

/// Visite d'une annonce (besoin S4) : faite ou planifiée, participants
/// (identifiants des membres), compte rendu, points positifs et négatifs,
/// note. Les photos sont des lignes `VisitPhoto` (objets privés dans
/// Supabase Storage).
model Visit {
  id             String      @id @default(uuid())
  listingId      String      @map("listing_id")
  visitedAt      DateTime    @map("visited_at") @db.Timestamptz(6)
  status         VisitStatus @default(done)
  participantIds String[]    @default([]) @map("participants")
  report         String?
  pros           String?
  cons           String?
  rating         Int         @default(0)
  prepTaskId     String?     @unique @map("prep_task_id")
  createdById    String?     @map("created_by_id")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  listing   Listing      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdBy Member?      @relation("VisitAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  prepTask  Task?        @relation("VisitPrepTask", fields: [prepTaskId], references: [id], onDelete: SetNull)
  photos    VisitPhoto[]

  @@index([listingId, visitedAt])
  @@map("visits")
  @@schema("app")
}

/// Une photo de visite : l'objet et sa vignette dans le bucket privé, sous
/// `<espace>/<annonce>/<visite>/`. Lue par URL signée à durée courte ;
/// supprimée par son auteur seulement.
model VisitPhoto {
  id                   String           @id @default(uuid())
  visitId              String           @map("visit_id")
  workspaceId          String           @map("workspace_id")
  status               VisitPhotoStatus @default(pending)
  storagePath          String           @unique @map("storage_path")
  thumbnailPath        String           @unique @map("thumbnail_path")
  contentType          String           @map("content_type")
  sizeBytes            Int              @map("size_bytes")
  thumbnailContentType String           @map("thumbnail_content_type")
  thumbnailSizeBytes   Int              @map("thumbnail_size_bytes")
  width                Int?
  height               Int?
  caption              String?
  uploadedById         String?          @map("uploaded_by_id")
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  readyAt              DateTime?        @map("ready_at") @db.Timestamptz(6)

  visit      Visit     @relation(fields: [visitId], references: [id], onDelete: Cascade)
  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploadedBy Member?   @relation("VisitPhotoAuthor", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([visitId])
  @@map("visit_photos")
  @@schema("app")
}

/// Qui a changé quoi, quand, par quel canal.
model ActivityLog {
  id            String          @id @default(uuid())
  workspaceId   String          @map("workspace_id")
  listingId     String?         @map("listing_id")
  actorMemberId String?         @map("actor_member_id")
  channel       ActivityChannel @default(web)
  action        String
  before        Json?
  after         Json?
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  listing       Listing?       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  actor         Member?        @relation(fields: [actorMemberId], references: [id], onDelete: SetNull)
  notifications Notification[]

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([listingId, createdAt(sort: Desc)])
  @@map("activity_logs")
  @@schema("app")
}

// ---------------------------------------------------------------------------
// Notifications (lot 6)
// ---------------------------------------------------------------------------

/// Une notification pour un membre, née d'une écriture journalisée. Le
/// texte est figé à la création (il part tel quel en push et par e-mail).
model Notification {
  id          String           @id @default(uuid())
  workspaceId String           @map("workspace_id")
  recipientId String           @map("recipient_id")
  type        NotificationType
  title       String
  body        String
  url         String?
  listingId   String?          @map("listing_id")
  activityId  String?          @map("activity_id")
  actorName   String?          @map("actor_name")
  /// Visible dans la cloche (préférence « dans l'application »).
  inApp       Boolean          @default(true) @map("in_app")
  pushStatus  DeliveryStatus   @default(skipped) @map("push_status")
  emailStatus DeliveryStatus   @default(skipped) @map("email_status")
  readAt      DateTime?        @map("read_at") @db.Timestamptz(6)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  recipient Member       @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  listing   Listing?     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  activity  ActivityLog? @relation(fields: [activityId], references: [id], onDelete: SetNull)

  @@index([recipientId, createdAt(sort: Desc)])
  @@index([pushStatus, createdAt])
  @@index([emailStatus, createdAt])
  @@map("notifications")
  @@schema("app")
}

/// Un abonnement Web Push d'un appareil (PWA). Supprimé quand le service
/// push répond qu'il a expiré (404 ou 410).
model PushSubscription {
  id            String    @id @default(uuid())
  memberId      String    @map("member_id")
  endpoint      String    @unique
  p256dh        String
  auth          String
  userAgent     String?   @map("user_agent")
  failureCount  Int       @default(0) @map("failure_count")
  lastSuccessAt DateTime? @map("last_success_at") @db.Timestamptz(6)
  lastFailureAt DateTime? @map("last_failure_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@map("push_subscriptions")
  @@schema("app")
}

/// Une annonce reçue (alerte e-mail transférée) à valider : la fiche
/// pré-remplie (JSON validé par ListingInputSchema), les doublons probables
/// à la réception, puis la décision d'un membre.
model ListingDraft {
  id           String         @id @default(uuid())
  workspaceId  String         @map("workspace_id")
  origin       DraftOrigin    @default(email)
  status       DraftStatus    @default(pending)
  extractedBy  DraftExtractor @map("extracted_by")
  input        Json           @map("listing_input")
  duplicates   Json           @default("[]")
  warnings     Json           @default("[]")
  url          String?
  emailSubject String?        @map("email_subject")
  emailFrom    String?        @map("email_from")
  receivedAt   DateTime       @default(now()) @map("received_at") @db.Timestamptz(6)
  decidedAt    DateTime?      @map("decided_at") @db.Timestamptz(6)
  decidedById  String?        @map("decided_by_id")
  listingId    String?        @map("listing_id")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  decidedBy Member?   @relation("DraftDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  listing   Listing?  @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, createdAt])
  @@map("listing_drafts")
  @@schema("app")
}

// ---------------------------------------------------------------------------
// Critères de recherche géographiques
// ---------------------------------------------------------------------------

model SearchCriteria {
  id          String  @id @default(uuid())
  workspaceId String  @map("workspace_id")
  createdById String? @map("created_by_id")
  name        String
  active      Boolean @default(true)
  /// JSON validé par CriteriaFiltersSchema
  filters     Json    @default("{}")

  perimeterType    PerimeterType?                           @map("perimeter_type")
  /// Point et rayon
  centerLatitude   Float?                                   @map("center_latitude")
  centerLongitude  Float?                                   @map("center_longitude")
  radiusMeters     Int?                                     @map("radius_meters")
  /// Polygone (dessiné ou isochrone figée) ; écrit et lu par le module geo.
  perimeter        Unsupported("geography(Polygon, 4326)")?
  perimeterGeoJson Json?                                    @map("perimeter_geojson")
  isochroneParams  Json?                                    @map("isochrone_params")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy Member?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  matches   CriteriaMatch[]

  @@index([workspaceId])
  @@map("search_criteria")
  @@schema("app")
}

/// Une annonce entrée dans un critère de recherche (alerte, badge). Mise à
/// jour à chaque écriture d'annonce et de critère ; les compteurs et la liste
/// filtrée, eux, sont recalculés à la lecture.
model CriteriaMatch {
  criteriaId  String   @map("criteria_id")
  listingId   String   @map("listing_id")
  matchedAt   DateTime @default(now()) @map("matched_at") @db.Timestamptz(6)
  /// Localisation imprécise (quartier ou commune) : incluse sous réserve.
  approximate Boolean  @default(false)

  criteria SearchCriteria @relation(fields: [criteriaId], references: [id], onDelete: Cascade)
  listing  Listing        @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([criteriaId, listingId])
  @@index([listingId])
  @@map("criteria_matches")
  @@schema("app")
}

// ---------------------------------------------------------------------------
// Données ouvertes importées
// ---------------------------------------------------------------------------

/// Arrêts de tram et de bus (import TBM). `line` liste les lignes qui
/// desservent l'arrêt, séparées par des virgules (« A, C »).
model TransitStop {
  id         String                                 @id @default(uuid())
  network    String
  mode       TransitMode                            @default(bus)
  line       String?
  name       String
  externalId String?                                @map("external_id")
  latitude   Float
  longitude  Float
  geom       Unsupported("geography(Point, 4326)")?
  importedAt DateTime                               @default(now()) @map("imported_at") @db.Timestamptz(6)

  @@unique([network, externalId])
  @@index([network, line])
  @@index([mode])
  @@map("transit_stops")
  @@schema("app")
}

/// Ventes DVF (import Gironde, filtré sur Bordeaux Métropole) : une ligne par
/// mutation ne portant qu'un appartement. `externalId` est l'identifiant de
/// mutation (id_mutation) ; l'import est un upsert idempotent sur cette clé.
model DvfSale {
  id             String                                 @id @default(uuid())
  externalId     String?                                @unique @map("external_id")
  mutationDate   DateTime                               @map("mutation_date") @db.Date
  mutationNature String?                                @map("mutation_nature")
  price          Decimal                                @db.Decimal(12, 2)
  surface        Decimal?                               @db.Decimal(8, 2)
  propertyType   String                                 @map("property_type")
  rooms          Int?
  address        String?
  postalCode     String?                                @map("postal_code")
  commune        String?
  inseeCode      String?                                @map("insee_code")
  latitude       Float?
  longitude      Float?
  geom           Unsupported("geography(Point, 4326)")?
  pricePerM2     Decimal?                               @map("price_per_m2") @db.Decimal(10, 2)
  source         String?
  importedAt     DateTime                               @default(now()) @map("imported_at") @db.Timestamptz(6)

  @@index([inseeCode, mutationDate])
  @@index([mutationDate])
  @@map("dvf_sales")
  @@schema("app")
}

/// Secteurs de l'encadrement des loyers (zonage de l'observatoire local des
/// loyers de Bordeaux, un polygone par IRIS) ; la zone se lit dans le module
/// geo. Les loyers de référence par arrêté sont dans ReferenceData (sorte
/// `rent_reference`).
model RentControlZone {
  id         String                                        @id @default(uuid())
  territory  String
  zone       Int
  label      String
  irisCode   String                                        @map("iris_code")
  inseeCode  String                                        @map("insee_code")
  geom       Unsupported("geography(MultiPolygon, 4326)")?
  source     String?
  importedAt DateTime                                      @default(now()) @map("imported_at") @db.Timestamptz(6)

  @@unique([territory, irisCode])
  @@index([territory, zone])
  @@map("rent_control_zones")
  @@schema("app")
}

/// Équipements de proximité (lot 11) : pistes d'athlétisme (recensement des
/// équipements sportifs du ministère des Sports), supermarchés avec drive et
/// salles Fitness Park (OpenStreetMap). Une ligne par objet de la source ;
/// l'import remplace toutes les lignes d'un couple (genre, source) dans une
/// transaction. `details` porte les attributs propres au genre (nature,
/// couverture, longueur, accès, preuve du drive), validés par
/// `AmenityDetailsSchema` à la lecture.
model Amenity {
  id              String                                 @id @default(uuid())
  kind            AmenityKind
  /// Source : `res` (ministère des Sports) ou `osm` (OpenStreetMap).
  source          String
  /// Identifiant dans la source (numéro d'équipement RES, `node/123` OSM).
  externalId      String                                 @map("external_id")
  name            String
  /// Enseigne telle que la source la nomme (« Carrefour Market »).
  brand           String?
  /// Groupe d'enseigne : carrefour, auchan, intermarche ou other.
  brandGroup      String?                                @map("brand_group")
  drive           DriveStatus?
  address         String?
  commune         String?
  inseeCode       String?                                @map("insee_code")
  details         Json                                   @default("{}")
  latitude        Float
  longitude       Float
  geom            Unsupported("geography(Point, 4326)")?
  /// Date de mise à jour de l'objet dans la source, quand elle la donne.
  sourceUpdatedAt DateTime?                              @map("source_updated_at") @db.Date
  importedAt      DateTime                               @default(now()) @map("imported_at") @db.Timestamptz(6)

  @@unique([kind, source, externalId])
  @@index([kind, brandGroup])
  @@map("amenities")
  @@schema("app")
}

/// Contours des quartiers de Bordeaux Métropole (lot 11) : quartiers
/// officiels là où la commune en publie, IRIS de l'INSEE ailleurs, commune
/// entière pour une commune non découpée. `source` dit d'où vient chaque
/// contour ; l'import remplace tout le territoire dans une transaction.
model Neighbourhood {
  id         String                                        @id @default(uuid())
  territory  String
  kind       NeighbourhoodKind
  /// Identifiant dans la source (code IRIS, identifiant du quartier).
  code       String
  name       String
  /// Quartier plus large qui le contient (quartier administratif d'un
  /// secteur de vie de Bordeaux), si la source le donne.
  parent     String?
  commune    String
  inseeCode  String                                        @map("insee_code")
  source     String
  geom       Unsupported("geography(MultiPolygon, 4326)")?
  /// Ce que la carte dessine : le contour entier, ou pour l'IRIS d'une
  /// commune à quartiers officiels la seule part hors de ces quartiers
  /// (morceaux d'au moins 1 ha une fois rognés de 25 m : pas les liserés),
  /// null si rien n'est à dessiner. Calculé par
  /// l'import (module geo).
  mapGeom    Unsupported("geography(MultiPolygon, 4326)")? @map("map_geom")
  importedAt DateTime                                      @default(now()) @map("imported_at") @db.Timestamptz(6)

  @@unique([territory, code])
  @@index([territory, inseeCode])
  @@map("neighbourhoods")
  @@schema("app")
}

/// Lieux-dits OpenStreetMap (lot 12) : `place=neighbourhood`, `quarter` ou
/// `suburb`, un point par objet, rattaché à la commune dont un contour
/// importé le contient. Repli du placement d'une annonce au quartier quand
/// aucun contour ne porte le nom cité.
model Place {
  id         String                                 @id @default(uuid())
  /// Source : `osm`.
  source     String
  /// Identifiant dans la source (`node/123`, `relation/456`).
  externalId String                                 @map("external_id")
  name       String
  /// Valeur de `place` : neighbourhood, quarter ou suburb.
  placeType  String                                 @map("place_type")
  commune    String?
  inseeCode  String?                                @map("insee_code")
  latitude   Float
  longitude  Float
  geom       Unsupported("geography(Point, 4326)")?
  importedAt DateTime                               @default(now()) @map("imported_at") @db.Timestamptz(6)

  @@unique([source, externalId])
  @@index([inseeCode])
  @@map("places")
  @@schema("app")
}

/// Données de référence datées (loyers de référence, calendrier DPE, barème
/// notaire) et cache des appels open data.
model ReferenceData {
  id        String    @id @default(uuid())
  kind      String
  key       String
  validFrom DateTime? @map("valid_from") @db.Date
  payload   Json
  fetchedAt DateTime  @default(now()) @map("fetched_at") @db.Timestamptz(6)

  @@unique([kind, key])
  @@map("reference_data")
  @@schema("app")
}
