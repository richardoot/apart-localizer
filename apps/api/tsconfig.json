{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // CommonJS output (no "type": "module") that still resolves ESM-only
    // packages through their exports map, the way Node 24 does with require(esm).
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolvePackageJsonExports": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "paths": {
      "@/*": ["./src/*"]
    },
    // TypeScript 6 stops loading every @types package by default.
    "types": ["node"],
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "ES2022",
    "incremental": true,
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo",
    "skipLibCheck": true,
    // nestjs-zod's DTO classes are typed as mapped types that the default
    // exact-optional check rejects at the `@Body()` boundary.
    "exactOptionalPropertyTypes": false
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "**/*.spec.ts",
    "**/*.e2e-spec.ts"
  ]
}
