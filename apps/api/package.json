{
  "name": "@apart/api",
  "version": "0.0.0",
  "private": true,
  "description": "API NestJS : REST, MCP, géo PostGIS, Prisma 7",
  "engines": {
    "node": "24.x"
  },
  "volta": {
    "extends": "../../package.json"
  },
  "scripts": {
    "build": "pnpm prisma:generate && nest build",
    "build:vercel": "pnpm prisma:generate && pnpm prisma:deploy && nest build && pnpm check:vercel-runtime",
    "check:vercel-runtime": "node --no-experimental-require-module -e \"require('./dist/app.module')\"",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:prod": "node dist/main",
    "type-check": "pnpm prisma:generate && tsc --noEmit -p tsconfig.eslint.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "pnpm prisma:generate && vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "pnpm prisma:generate && vitest run --config vitest.config.e2e.ts",
    "prisma:generate": "prisma generate --config prisma/prisma.config.ts",
    "prisma:migrate": "prisma migrate dev --config prisma/prisma.config.ts",
    "prisma:deploy": "prisma migrate deploy --config prisma/prisma.config.ts",
    "prisma:studio": "prisma studio --config prisma/prisma.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.4.0",
    "@apart/contracts": "workspace:*",
    "@apart/domain": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@nestjs/common": "11.2.8",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@sentry/nestjs": "11.10.0",
    "@supabase/supabase-js": "2.118.0",
    "dotenv": "18.0.9",
    "helmet": "8.3.0",
    "nestjs-zod": "5.5.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.8",
    "@swc/core": "1.16.21",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
