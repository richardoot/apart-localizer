{
  "name": "@apart/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Schémas Zod partagés : annonces, hypothèses, GeoJSON, filtres (API, MCP, IA, formulaires)",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && pnpm build:cjs",
    "build:cjs": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=cjs --packages=external --sourcemap --outfile=dist/index.cjs --log-level=warning",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "24.x"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
