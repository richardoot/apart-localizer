{
  "name": "apart-localizer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter @apart/web dev",
    "dev:api": "pnpm --filter @apart/api dev",
    "stack:up": "pnpm --silent --filter @apart/scripts stack up",
    "stack:down": "pnpm --silent --filter @apart/scripts stack down",
    "stack:status": "pnpm --silent --filter @apart/scripts stack status",
    "stack:reset": "pnpm --silent --filter @apart/scripts stack reset",
    "verify": "pnpm --silent --filter @apart/scripts verify",
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter './packages/*' build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "pnpm build:packages && pnpm -r type-check",
    "test": "pnpm build:packages && pnpm -r test",
    "test:unit": "pnpm build:packages && pnpm -r test:unit",
    "test:e2e": "pnpm build:packages && pnpm -r test:e2e",
    "db:test:up": "podman compose -f docker/test-db.yml up -d || docker compose -f docker/test-db.yml up -d",
    "db:test:down": "podman compose -f docker/test-db.yml down || docker compose -f docker/test-db.yml down",
    "seed:demo": "pnpm --filter @apart/scripts seed:demo",
    "link:identities": "pnpm --filter @apart/scripts link:identities",
    "import:artifact": "pnpm --filter @apart/scripts import:artifact",
    "import:rent-control": "pnpm --filter @apart/scripts import:rent-control",
    "import:rent-observatory": "pnpm --filter @apart/scripts import:rent-observatory",
    "import:transit-stops": "pnpm --filter @apart/scripts import:transit-stops",
    "import:dvf": "pnpm --filter @apart/scripts import:dvf",
    "geocode:missing": "pnpm --filter @apart/scripts geocode:missing",
    "import:sports-facilities": "pnpm --filter @apart/scripts import:sports-facilities",
    "import:supermarkets": "pnpm --filter @apart/scripts import:supermarkets",
    "import:neighbourhoods": "pnpm --filter @apart/scripts import:neighbourhoods",
    "refresh:surroundings": "pnpm --filter @apart/scripts refresh:surroundings",
    "import:places": "pnpm --filter @apart/scripts import:places",
    "relocate:listings": "pnpm --filter @apart/scripts relocate:listings",
    "refresh:criteria-fit": "pnpm --filter @apart/scripts refresh:criteria-fit"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "engines": {
    "node": "24.x"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix --max-warnings=100"
    ],
    "*.{js,ts,vue,json,md,yaml,yml,css}": [
      "prettier --write"
    ]
  },
  "volta": {
    "node": "24.21.0"
  }
}
