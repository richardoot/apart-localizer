{
  "name": "@apart/scripts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Scripts d'exploitation : pile locale, jeu de démonstration, vérification, import de l'artefact, imports open data",
  "engines": {
    "node": "24.x"
  },
  "volta": {
    "extends": "../package.json"
  },
  "scripts": {
    "import:artifact": "tsx import-artifact.ts",
    "import:rent-control": "tsx import-rent-control.ts",
    "import:rent-observatory": "tsx import-rent-observatory.ts",
    "import:transit-stops": "tsx import-transit-stops.ts",
    "import:dvf": "tsx import-dvf.ts",
    "geocode:missing": "tsx geocode-missing.ts",
    "import:sports-facilities": "tsx import-sports-facilities.ts",
    "import:supermarkets": "tsx import-supermarkets.ts",
    "import:neighbourhoods": "tsx import-neighbourhoods.ts",
    "refresh:surroundings": "tsx refresh-surroundings.ts",
    "import:places": "tsx import-places.ts",
    "relocate:listings": "tsx relocate-listings.ts",
    "refresh:criteria-fit": "tsx refresh-criteria-fit.ts",
    "refresh:target-rent": "tsx refresh-target-rent.ts",
    "stack": "tsx stack.ts",
    "seed:demo": "tsx seed-demo.ts",
    "link:identities": "tsx link-local-identities.ts",
    "verify": "tsx verify.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run && vitest run --config vitest.config.e2e.ts",
    "test:unit": "vitest run",
    "test:e2e": "vitest run --config vitest.config.e2e.ts"
  },
  "dependencies": {
    "@apart/contracts": "workspace:*",
    "@apart/domain": "workspace:*",
    "@nestjs/common": "11.2.8",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "18.0.9",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
